  (hconstruction :
    ∀ (r : ℕ),
      10 ≤ r →
        ¬IsSquare r →
          ∀ (d m : ℕ),
            0 < d →
              0 < m →
                3 < ↑d / ↑m →
                  ↑d / ↑m < √↑r →
                    (OAI.Nagata.W13.UniversalSupport r d fun x => m) →
                      ∀ (n : ℕ) (delta : ℝ) (x : Fin 9 → ℝ),
                        0 < n →
                          0 < delta →
                            delta < 1 / 2 →
                              Function.Injective x →
                                (∀ (i : Fin 9), 0 < x i ∧ x i < 1 / 2) →
                                  ∑ i, OAI.Nagata.W29.sourceOffsets x i = delta →
                                    (∀ (j : ℤ),
                                        0 ≤ j →
                                          j ≤ ↑(n * m) →
                                            OAI.Nagata.FiniteExponents.firstLower (↑(n * d)) (↑(n * m)) j
                                                (3 * (√↑r - 3)) delta ∉
                                              Set.range Int.cast) →
                                      (∀ (j : ℤ),
                                          ↑(n * m) < j →
                                            j ≤ ↑(n * d) / 3 →
                                              0 < ↑(n * d) - 3 * j →
                                                OAI.Nagata.FiniteExponents.secondLower (↑(n * d)) j (3 * (√↑r - 3))
                                                    delta ∉
                                                  Set.range Int.cast) →
                                        (OAI.Nagata.FiniteExponents.exponentSet (↑(n * d)) (↑(n * m)) (3 * (√↑r - 3))
                                              delta).Nonempty →
                                          ∀ᶠ (τ : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                                            ∃ (hτ : 0 < τ) (hτone : τ < 1),
                                              ∃ U,
                                                IsOpen U ∧
                                                  0 ∈ U ∧
                                                    ∀ (p : Fin (r - 9) → ℂ),
                                                      Function.Injective p →
                                                        (∀ (i : Fin (r - 9)), p i ∈ U) →
                                                          ∃ F,
                                                            F ≠ 0 ∧
                                                              ∀ (i : Fin (r - 9)),
                                                                OAI.Nagata.Workers.W28.HasAnalyticOrderAtLeast
                                                                  (fun z =>
                                                                    OAI.Nagata.W20.localScalar F
                                                                      (OAI.Nagata.Workers.W10.tauPower τ (1 / 2)) z.1
                                                                      z.2)
                                                                  (p i, 0) (n * m)) :
