OAI.Nagata.nagata_conjecture (r : ℕ) :
  10 ≤ r →
    ∃ E,
      (∀ (n : ℕ), OAI.Nagata.ProjectiveGeometry.IsConfigurationZariskiClosed (E n) ∧ E n ≠ Set.univ) ∧
        (∃ p, ∀ (n : ℕ), p ∉ E n) ∧
          ∀ (p : OAI.Nagata.ProjectiveGeometry.OrderedDistinctPoints r),
            (∀ (n : ℕ), p ∉ E n) →
              ∀ (C : OAI.Nagata.Workers.W10.EffectivePlaneCurve) (m : Fin r → ℕ),
                (∀ (i : Fin r), m i ≤ OAI.Nagata.W15.curveOrdinaryMultiplicity C (↑p i)) →
                  ∑ i, ↑(m i) < ↑(OAI.Nagata.Workers.W10.curveDegree C) * √↑r
