run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool × Bool) := [(`LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso_coefficient_general,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso_factorization_general,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_cachedCechHomologyIso_general,false,false),(`LinearStudy.nativeIndependentFiniteNormalization_cachedCechHomologyIso_coefficient_general,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso_coefficient_general,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso_factorization_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechChartBijections_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_homology_coefficient_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_coefficient_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_coefficient_general_typed,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductFamily_coefficient_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechCoefficientBuilder_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_coefficient_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_coefficient_general_typed,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_coefficient_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechCoefficientBuilder_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechCoefficientTargetBuilder_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_coefficient_general_typed,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_coefficient_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_coefficient_builder_general,true,false),(