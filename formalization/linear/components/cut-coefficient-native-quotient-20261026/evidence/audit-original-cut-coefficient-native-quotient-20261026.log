def LinearStudy.projectivePulledCutEquationCoefficientQuotientDualStatement : {n r : ℕ} →
  LinearStudy.HomogeneousEndomorphism n →
    LinearStudy.IntegralProjectiveEquations n →
      (Fin (r + 1) → LinearStudy.CoordinateRing n) → (Fin (r + 1) → ℂ) → Prop :=
fun {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
    (L : Fin (r + 1) → LinearStudy.CoordinateRing n) (w : Fin (r + 1) → ℂ) =>
  let R := MvPolynomial (Fin r) ℂ;
  let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal;
  let J :=
    Ideal.map LinearStudy.affineChartPolynomialMap.toRingHom (LinearStudy.projectivePulledLinearSectionIdeal f V L w);
  let Q := MvPolynomial (Fin n) ℂ ⧸ J;
  let phi := LinearStudy.projectivePulledCutEquationMap f V L w;
  let D := (ModuleCat.coextendScalars (algebraMap R B)).obj ↧R;
  have I :=
    Ideal.span
      (Set.range fun (i : Fin r) =>
        (Ideal.Quotient.mk V.affineIdeal)
          (LinearStudy.affineChartPolynomialMap
            ((MvPolynomial.aeval f.forms) (LinearStudy.projectiveLinearSectionForms L w i))));
  ∃ (F : (↑D ⧸ I • ⊤) ≃ₗ[ℂ] Module.Dual ℂ Q),
    (∀ (ell : ↑D) (P : MvPolynomial (Fin n) ℂ),
        (F (Submodule.Quotient.mk ell)) ((Ideal.Quotient.mk J) P) =
          (algebraMap R ℂ)
            ((LinearStudy.coextensionOriginalDualEquiv
                (have this := ell;
                this))
              ((Ideal.Quotient.mk V.affineIdeal) P))) ∧
      (∀ (ell : ↑D),
          (F (Submodule.Quotient.mk ell)) 1 =
            (algebraMap R ℂ)
              ((LinearStudy.coextensionOriginalDualEquiv
                  (have this := ell;
                  this))
                1)) ∧
        ∀ (P : MvPolynomial (Fin n) ℂ) (z : ↑D ⧸ I • ⊤) (q : Q),
          (F ((Ideal.Quotient.mk V.affineIdeal) P • z)) q = (F z) (q * (Ideal.Quotient.mk J) P)
