  [inst : Field K] →
    [inst_1 : CommRing B] →
      [inst_2 : CommRing Q] →
        [inst_3 : Algebra K Q] →
          [inst_4 : AddCommGroup N] →
            [inst_5 : Module K N] →
              [inst_6 : Module B N] →
                (beta : B →+* Q) →
                  (E : N ≃ₗ[K] Module.Dual K Q) →
                    (∀ (b : B) (z : N) (q : Q), (E (b • z)) q = (E z) (q * beta b)) →
                      N ≃ₗ[B]
                        ↑((ModuleCat.restrictScalars beta).obj ((ModuleCat.coextendScalars (algebraMap K Q)).obj ↧K)) :=
