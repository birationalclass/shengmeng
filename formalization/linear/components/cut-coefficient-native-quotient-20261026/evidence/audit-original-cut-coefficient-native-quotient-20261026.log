    (beta : B →+* Q) (E : N ≃ₗ[K] Module.Dual K Q)
    (hE : ∀ (b : B) (z : N) (q : Q), (E (b • z)) q = (E z) (q * beta b)) =>
  let c := LinearStudy.coextensionOriginalDualEquiv;
  let e := E.toAddEquiv.trans c.symm.toAddEquiv;
  { toFun := e.toFun, map_add' := ⋯, map_smul' := ⋯, invFun := e.invFun, left_inv := ⋯, right_inv := ⋯ }
