    [inst_1 : CommRing S] →
      [inst_2 : CommRing K] →
        [inst_3 : Algebra R S] →
          [inst_4 : Algebra R K] →
            [inst_5 : AddCommGroup N] →
              [inst_6 : Module S N] →
                [inst_7 : Module R N] →
                  [inst_8 : IsScalarTower R S N] →
                    Function.Surjective ⇑(algebraMap R K) →
                      (N ⧸ Ideal.map (algebraMap R S) (RingHom.ker (algebraMap R K)) • ⊤) ≃ₗ[R] TensorProduct R K N :=
fun {R S K N : Type u} [CommRing R] [CommRing S] [CommRing K] [Algebra R S] [Algebra R K] [AddCommGroup N] [Module S N]
    [Module R N] [IsScalarTower R S N] (hres : Function.Surjective ⇑(algebraMap R K)) =>
  let m := RingHom.ker (algebraMap R K);
  let P := Ideal.map (algebraMap R S) m • ⊤;
  have hP := ⋯;
  have e := Ideal.quotientKerAlgEquivOfSurjective hres;
  (Submodule.Quotient.restrictScalarsEquiv R P).symm.trans
    (((Submodule.restrictScalars R P).quotEquivOfEq (m • ⊤) hP).trans
      ((TensorProduct.quotTensorEquivQuotSMul N m).symm.trans (TensorProduct.congr (↑e) (LinearEquiv.refl R N))))
