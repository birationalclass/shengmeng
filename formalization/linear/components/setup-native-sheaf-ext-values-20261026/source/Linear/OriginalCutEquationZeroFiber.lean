module
public import Linear.PolynomialLocalParameters
public import Linear.ProjectiveCutKoszulQuotient
@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 100000
namespace LinearStudy
/-- The zero fiber ideal of the ACTUAL equation map is generated by the
SAME equations,not a radical or an isomorphic replacement ideal. -/
theorem polynomial_equation_zero_fiber_ideal
    {K S : Type*} [Field K] [CommRing S] [Algebra K S] {r : ℕ}
    (H : Fin r → S) :
    (RingHom.ker (MvPolynomial.aeval (R:=K) (0 : Fin r → K)).toRingHom).map
      (MvPolynomial.aeval H).toRingHom=Ideal.span (Set.range H) := by
  have hm := polynomial_point_kernel_eq_span_centered_coordinates (0 : Fin r → K)
  simp only [Pi.zero_apply,map_zero,sub_zero] at hm
  rw [hm,Ideal.map_span,← Set.range_comp']
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext i
  exact MvPolynomial.aeval_X H i
/-- The ACTUAL zero fiber of the SAME original pulled cut-equation map
is reduced,DERIVED from original cut reducedness via the already PROVED
original Koszul quotient equivalence. No normalized trace is asserted. -/
theorem projectivePulledCutEquation_zero_fiber_reduced {n r : ℕ}
    (f : HomogeneousEndomorphism n) (V : IntegralProjectiveEquations n)
    (L : Fin (r+1) → CoordinateRing n) (w : Fin (r+1) → ℂ)
    [IsReduced (MvPolynomial (Fin n) ℂ ⧸
      (projectivePulledLinearSectionIdeal f V L w).map
        (affineChartPolynomialMap (K:=ℂ)).toRingHom)] :
    let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal
    let H : Fin r → B := fun i => Ideal.Quotient.mk V.affineIdeal
      (affineChartPolynomialMap (MvPolynomial.aeval f.forms (projectiveLinearSectionForms L w i)))
    IsReduced (B ⧸ (RingHom.ker
      (MvPolynomial.aeval (R:=ℂ) (0 : Fin r → ℂ)).toRingHom).map
        (MvPolynomial.aeval H).toRingHom) := by
  dsimp only
  rw [polynomial_equation_zero_fiber_ideal]
  let E := projectivePulledLinearSection_koszulQuotientAlgEquiv f V L w
  exact isReduced_of_injective E.toRingHom E.injective
/-- Original finite cut ring derives finiteness of the ACTUAL equation
map zero fiber through the SAME original quotient equivalence. -/
theorem projectivePulledCutEquation_zero_fiber_finite {n r : ℕ}
    (f : HomogeneousEndomorphism n) (V : IntegralProjectiveEquations n)
    (L : Fin (r+1) → CoordinateRing n) (w : Fin (r+1) → ℂ)
    [Module.Finite ℂ (MvPolynomial (Fin n) ℂ ⧸
      (projectivePulledLinearSectionIdeal f V L w).map
        (affineChartPolynomialMap (K:=ℂ)).toRingHom)] :
    let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal
    let H : Fin r → B := fun i => Ideal.Quotient.mk V.affineIdeal
      (affineChartPolynomialMap (MvPolynomial.aeval f.forms (projectiveLinearSectionForms L w i)))
    Module.Finite ℂ (B ⧸ (RingHom.ker
      (MvPolynomial.aeval (R:=ℂ) (0 : Fin r → ℂ)).toRingHom).map
        (MvPolynomial.aeval H).toRingHom) := by
  dsimp only
  rw [polynomial_equation_zero_fiber_ideal]
  exact Module.Finite.equiv (projectivePulledLinearSection_koszulQuotientAlgEquiv f V L w).symm.toLinearEquiv
end LinearStudy
