def LinearStudy.projectivePulledCutEquationCoefficientSheafDualStatement : {n r : ℕ} →
  LinearStudy.HomogeneousEndomorphism n →
    LinearStudy.IntegralProjectiveEquations n →
      (Fin (r + 1) → LinearStudy.CoordinateRing n) → (Fin (r + 1) → ℂ) → Prop :=
fun {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
    (L : Fin (r + 1) → LinearStudy.CoordinateRing n) (w : Fin (r + 1) → ℂ) =>
  let R := MvPolynomial (Fin r) ℂ;
  let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal;
  let J :=
    Ideal.map LinearStudy.affineChartPolynomialMap.toRingHom (LinearStudy.projectivePulledLinearSectionIdeal f V L w);
  let Q := MvPolynomial (Fin n) ℂ ⧸ J;
  let phi := LinearStudy.projectivePulledCutEquationMap f V L w;
  let D := (ModuleCat.coextendScalars (algebraMap R B)).obj ↧R;
  let Dq := (ModuleCat.coextendScalars (algebraMap ℂ Q)).obj ↧ℂ;
  have I :=
    Ideal.span
      (Set.range fun (i : Fin r) =>
        (Ideal.Quotient.mk V.affineIdeal)
          (LinearStudy.affineChartPolynomialMap
            ((MvPolynomial.aeval f.forms) (LinearStudy.projectiveLinearSectionForms L w i))));
  let Bc := ↧B;
  let Qc := ↧Q;
  have beta := CommRingCat.ofHom (LinearStudy.projectivePulledCutOriginalRingMap f V L w).toRingHom;
  let M := ↧(↑D ⧸ I • ⊤);
  ∃ (e :
    AlgebraicGeometry.tilde M ≅
      (AlgebraicGeometry.Scheme.Modules.pushforward (AlgebraicGeometry.Spec.map beta)).obj
        (AlgebraicGeometry.tilde Dq)),
    (∀ (ell : ↑D) (P : MvPolynomial (Fin n) ℂ),
        ((ModuleCat.CoextendScalars.equiv (algebraMap ℂ Q) ↧ℂ)
              (have this := LinearStudy.tildePushforwardOriginalGlobalValue beta Dq M e (Submodule.Quotient.mk ell);
              this))
            ((Ideal.Quotient.mk J) P) =
          (algebraMap R ℂ)
            ((LinearStudy.coextensionOriginalDualEquiv
                (have this := ell;
                this))
              ((Ideal.Quotient.mk V.affineIdeal) P))) ∧
      ∀ (ell : ↑D),
        ((ModuleCat.CoextendScalars.equiv (algebraMap ℂ Q) ↧ℂ)
              (have this := LinearStudy.tildePushforwardOriginalGlobalValue beta Dq M e (Submodule.Quotient.mk ell);
              this))
            1 =
          (algebraMap R ℂ)
            ((LinearStudy.coextensionOriginalDualEquiv
                (have this := ell;
                this))
              1)
def LinearStudy.koszulExactTopExtOriginalCoefficientEquiv.{u} : {R : Type u} →
  [inst : CommRing R] →
    (p : ℕ) →
      (H : Fin (p + 1) → R) →
        (∀ (j : ℕ), 0 < j → HomologicalComplex.ExactAt (koszulComplex (Fintype.linearCombination R H)) j) →
          (N : ModuleCat R) →
            (T : Type u) →
              [inst_1 : AddCommGroup T] →
                [inst_2 : Module R T] →
                  ((↑N ⧸ Ideal.span (Set.range H) • ⊤) ≃ₗ[R] T) →
                    CategoryTheory.Abelian.Ext (↧(R ⧸ Ideal.span (Set.range H))) N (p + 1) ≃ₗ[R] T :=
fun {R : Type u} [CommRing R] (p : ℕ) (H : Fin (p + 1) → R)
    (he : ∀ (j : ℕ), 0 < j → HomologicalComplex.ExactAt (koszulComplex (Fintype.linearCombination R H)) j)
    (N : ModuleCat R) (T : Type u) [AddCommGroup T] [Module R T] (F : (↑N ⧸ Ideal.span (Set.range H) • ⊤) ≃ₗ[R] T) =>
  (LinearStudy.koszulExactTopExtCoefficientRestrictionEquiv p H he N).trans F
def LinearStudy.koszulExactTopExtOriginalTwoValuesStatement.{u} : {R : Type u} →
  [inst : CommRing R] →
    (p : ℕ) →
      (Fin (p + 1) → R) →
        (N : ModuleCat R) →
          (T : Type u) →
            [inst_1 : AddCommGroup T] → [Module R T] → (U : Type u) → (↑N → U → T → Prop) → (↑N → T → Prop) → Prop :=
fun {R : Type u} [CommRing R] (p : ℕ) (H : Fin (p + 1) → R) (N : ModuleCat R) (T : Type u) [AddCommGroup T] [Module R T]
    (U : Type u) (P : ↑N → U → T → Prop) (P0 : ↑N → T → Prop) =>
  ∃ (hx : ∀ (j : ℕ), 0 < j → HomologicalComplex.ExactAt (koszulComplex (Fintype.linearCombination R H)) j) (G :
    CategoryTheory.Abelian.Ext (↧(R ⧸ Ideal.span (Set.range H))) N (p + 1) ≃ₗ[R] T),
    (∀ (L : ↥(⋀[R]^(p + 1) (Fin (p + 1) → R)) →ₗ[R] ↑N) (v : U),
        P (L (LinearStudy.topKoszulGenerator (p + 1))) v
          (G (LinearStudy.koszulExactTopExtCoefficientRepresentative p H hx N L))) ∧
      ∀ (L : ↥(⋀[R]^(p + 1) (Fin (p + 1) → R)) →ₗ[R] ↑N),
        P0 (L (LinearStudy.topKoszulGenerator (p + 1)))
          (G (LinearStudy.koszulExactTopExtCoefficientRepresentative p H hx N L))
def LinearStudy.projectivePulledCutEquationCoefficientModuleExtDualStatement : {n p : ℕ} →
  LinearStudy.HomogeneousEndomorphism n →
    LinearStudy.IntegralProjectiveEquations n →
      (Fin (p + 1 + 1) → LinearStudy.CoordinateRing n) → (Fin (p + 1 + 1) → ℂ) → Prop :=
fun {n p : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
    (L : Fin (p + 1 + 1) → LinearStudy.CoordinateRing n) (w : Fin (p + 1 + 1) → ℂ) =>
  let R := MvPolynomial (Fin (p + 1)) ℂ;
  let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal;
  let J :=
    Ideal.map LinearStudy.affineChartPolynomialMap.toRingHom (LinearStudy.projectivePulledLinearSectionIdeal f V L w);
  let Q := MvPolynomial (Fin n) ℂ ⧸ J;
  have phi := LinearStudy.projectivePulledCutEquationMap f V L w;
  let D := (ModuleCat.coextendScalars (algebraMap R B)).obj ↧R;
  let Dq := (ModuleCat.coextendScalars (algebraMap ℂ Q)).obj ↧ℂ;
  have H := fun (i : Fin (p + 1)) =>
    (Ideal.Quotient.mk V.affineIdeal)
      (LinearStudy.affineChartPolynomialMap
        ((MvPolynomial.aeval f.forms) (LinearStudy.projectiveLinearSectionForms L w i)));
  have I := Ideal.span (Set.range H);
  let T := (ModuleCat.restrictScalars (LinearStudy.projectivePulledCutOriginalRingMap f V L w).toRingHom).obj Dq;
  LinearStudy.koszulExactTopExtOriginalTwoValuesStatement p H D (↑T) (MvPolynomial (Fin n) ℂ)
    (fun (ell : ↑D) (P : MvPolynomial (Fin n) ℂ) (z : ↑T) =>
      ((ModuleCat.CoextendScalars.equiv (algebraMap ℂ Q) ↧ℂ)
            (have this := z;
            this))
          ((Ideal.Quotient.mk J) P) =
        (algebraMap R ℂ)
          ((LinearStudy.coextensionOriginalDualEquiv
              (have this := ell;
              this))
            ((Ideal.Quotient.mk V.affineIdeal) P)))
    fun (ell : ↑D) (z : ↑T) =>
    ((ModuleCat.CoextendScalars.equiv (algebraMap ℂ Q) ↧ℂ)
          (have this := z;
          this))
        1 =
      (algebraMap R ℂ)
        ((LinearStudy.coextensionOriginalDualEquiv
            (have this := ell;
            this))
          1)
def LinearStudy.koszulExactTopExtOriginalTwoSheafValuesStatement.{u} : {R S : CommRingCat} →
  (phi : R ⟶ S) →
    (p : ℕ) →
      (Fin (p + 1) → ↑R) →
        (N : ModuleCat ↑R) →
          (M : ModuleCat ↑S) →
            (U : Type u) →
              (↑N → U → ↑((ModuleCat.restrictScalars (CommRingCat.Hom.hom phi)).obj M) → Prop) →
                (↑N → ↑((ModuleCat.restrictScalars (CommRingCat.Hom.hom phi)).obj M) → Prop) → Prop :=
fun {R S : CommRingCat} (phi : R ⟶ S) (p : ℕ) (H : Fin (p + 1) → ↑R) (N : ModuleCat ↑R) (M : ModuleCat ↑S) (U : Type u)
    (P : ↑N → U → ↑((ModuleCat.restrictScalars (CommRingCat.Hom.hom phi)).obj M) → Prop)
    (P0 : ↑N → ↑((ModuleCat.restrictScalars (CommRingCat.Hom.hom phi)).obj M) → Prop) =>
  ∃ (he : ∀ (j : ℕ), 0 < j → HomologicalComplex.ExactAt (koszulComplex (Fintype.linearCombination (↑R) H)) j) (e :
    AlgebraicGeometry.tilde ↧(CategoryTheory.Abelian.Ext (↧(↑R ⧸ Ideal.span (Set.range H))) N (p + 1)) ≅
      (AlgebraicGeometry.Scheme.Modules.pushforward (AlgebraicGeometry.Spec.map phi)).obj (AlgebraicGeometry.tilde M)),
    (∀ (a : ↥(⋀[↑R]^(p + 1) (Fin (p + 1) → ↑R)) →ₗ[↑R] ↑N) (v : U),
        P (a (LinearStudy.topKoszulGenerator (p + 1))) v
          (LinearStudy.tildePushforwardOriginalGlobalValue phi M
            (↧(CategoryTheory.Abelian.Ext (↧(↑R ⧸ Ideal.span (Set.range H))) N (p + 1))) e
            (LinearStudy.koszulExactTopExtCoefficientRepresentative p H he N a))) ∧
      ∀ (a : ↥(⋀[↑R]^(p + 1) (Fin (p + 1) → ↑R)) →ₗ[↑R] ↑N),
        P0 (a (LinearStudy.topKoszulGenerator (p + 1)))
          (LinearStudy.tildePushforwardOriginalGlobalValue phi M
            (↧(CategoryTheory.Abelian.Ext (↧(↑R ⧸ Ideal.span (Set.range H))) N (p + 1))) e
            (LinearStudy.koszulExactTopExtCoefficientRepresentative p H he N a))
def LinearStudy.projectivePulledCutEquationCoefficientModuleExtSheafDualStatement : {n p : ℕ} →
  LinearStudy.HomogeneousEndomorphism n →
    LinearStudy.IntegralProjectiveEquations n →
      (Fin (p + 1 + 1) → LinearStudy.CoordinateRing n) → (Fin (p + 1 + 1) → ℂ) → Prop :=
fun {n p : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
    (L : Fin (p + 1 + 1) → LinearStudy.CoordinateRing n) (w : Fin (p + 1 + 1) → ℂ) =>
  let R := MvPolynomial (Fin (p + 1)) ℂ;
  let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal;
  let J :=
    Ideal.map LinearStudy.affineChartPolynomialMap.toRingHom (LinearStudy.projectivePulledLinearSectionIdeal f V L w);
  let Q := MvPolynomial (Fin n) ℂ ⧸ J;
  have phi := LinearStudy.projectivePulledCutEquationMap f V L w;
  let D := (ModuleCat.coextendScalars (algebraMap R B)).obj ↧R;
  let Dq := (ModuleCat.coextendScalars (algebraMap ℂ Q)).obj ↧ℂ;
  have H := fun (i : Fin (p + 1)) =>
    (Ideal.Quotient.mk V.affineIdeal)
      (LinearStudy.affineChartPolynomialMap
        ((MvPolynomial.aeval f.forms) (LinearStudy.projectiveLinearSectionForms L w i)));
  have I := Ideal.span (Set.range H);
  have T := (ModuleCat.restrictScalars (LinearStudy.projectivePulledCutOriginalRingMap f V L w).toRingHom).obj Dq;
  LinearStudy.koszulExactTopExtOriginalTwoSheafValuesStatement
    (CommRingCat.ofHom (LinearStudy.projectivePulledCutOriginalRingMap f V L w).toRingHom) p H D Dq
    (MvPolynomial (Fin n) ℂ)
    (fun (ell : ↑D) (P : MvPolynomial (Fin n) ℂ)
        (z :
          ↑((ModuleCat.restrictScalars
                  (CommRingCat.Hom.hom
                    (CommRingCat.ofHom (LinearStudy.projectivePulledCutOriginalRingMap f V L w).toRingHom))).obj
              Dq)) =>
      ((ModuleCat.CoextendScalars.equiv (algebraMap ℂ Q) ↧ℂ)
            (have this := z;
            this))
          ((Ideal.Quotient.mk J) P) =
        (algebraMap R ℂ)
          ((LinearStudy.coextensionOriginalDualEquiv
              (have this := ell;
              this))
            ((Ideal.Quotient.mk V.affineIdeal) P)))
    fun (ell : ↑D)
      (z :
        ↑((ModuleCat.restrictScalars
                (CommRingCat.Hom.hom
                  (CommRingCat.ofHom (LinearStudy.projectivePulledCutOriginalRingMap f V L w).toRingHom))).obj
            Dq)) =>
    ((ModuleCat.CoextendScalars.equiv (algebraMap ℂ Q) ↧ℂ)
          (have this := z;
          this))
        1 =
      (algebraMap R ℂ)
        ((LinearStudy.coextensionOriginalDualEquiv
            (have this := ell;
            this))
          1)
