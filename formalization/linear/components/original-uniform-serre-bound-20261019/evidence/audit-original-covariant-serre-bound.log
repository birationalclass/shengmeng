def LinearStudy.projectivePulledOriginalStructureTwistSerreBoundStatement : {n : ℕ} →
  LinearStudy.IntegralProjectiveEquations n → ℕ → Prop :=
fun {n : ℕ} (V : LinearStudy.IntegralProjectiveEquations n) (N : ℕ) =>
  ∀ (s : ℤ),
    ↑N ≤ s →
      ∀ (i : ℕ),
        0 < i →
          Subsingleton
            (CategoryTheory.Abelian.Ext
              (SheafOfModules.unit
                (AlgebraicGeometry.Proj (LinearStudy.homogeneousQuotientPiece V.ideal.toIdeal)).ringCatSheaf)
              (LinearStudy.nativeProjectiveModuleSheaf (LinearStudy.homogeneousQuotientPiece V.ideal.toIdeal)
                (LinearStudy.nativeProjectiveRingIntegerPiece (LinearStudy.homogeneousQuotientPiece V.ideal.toIdeal)) ⋯
                s)
              i)
