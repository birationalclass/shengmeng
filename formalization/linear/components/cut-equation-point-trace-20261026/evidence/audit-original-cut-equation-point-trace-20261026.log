def LinearStudy.projectivePulledCutEquationMap : {n r : ℕ} →
  LinearStudy.HomogeneousEndomorphism n →
    (V : LinearStudy.IntegralProjectiveEquations n) →
      (Fin (r + 1) → LinearStudy.CoordinateRing n) →
        (Fin (r + 1) → ℂ) → MvPolynomial (Fin r) ℂ →ₐ[ℂ] MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal :=
fun {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
    (L : Fin (r + 1) → LinearStudy.CoordinateRing n) (w : Fin (r + 1) → ℂ) =>
  (Ideal.Quotient.mkₐ ℂ V.affineIdeal).comp
    (MvPolynomial.aeval fun (i : Fin r) =>
      LinearStudy.affineChartPolynomialMap
        ((MvPolynomial.aeval f.forms) (LinearStudy.projectiveLinearSectionForms L w i)))
def LinearStudy.projectivePulledCutEquationTraceOneStatement : {n r : ℕ} →
  LinearStudy.HomogeneousEndomorphism n →
    LinearStudy.IntegralProjectiveEquations n →
      (Fin (r + 1) → LinearStudy.CoordinateRing n) → (Fin (r + 1) → ℂ) → Prop :=
fun {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
    (L : Fin (r + 1) → LinearStudy.CoordinateRing n) (w : Fin (r + 1) → ℂ) =>
  let R := MvPolynomial (Fin r) ℂ;
  let B := MvPolynomial (Fin n) ℂ ⧸ V.affineIdeal;
  let phi := LinearStudy.projectivePulledCutEquationMap f V L w;
  ∀ (e : TensorProduct R ℂ B),
    e ≠ 0 →
      e * e = e →
        ∃ (z :
          TensorProduct R ℂ
            ↑((ModuleCat.restrictScalars (algebraMap R B)).obj ((ModuleCat.coextendScalars (algebraMap R B)).obj ↧R))),
          (LinearStudy.coextensionOriginalResidueFiberPointEnd ⋯ e) z = z ∧
            LinearStudy.coextensionOriginalBaseChangedEvaluationAtOne z = 1
