run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool × Bool) := [(`LinearStudy.orderedCechIndex_delete_values,true,true),(`LinearStudy.orderedAbelianOpenSectionComparisonIso_restrict,true,false),(`LinearStudy.orderedCrossSpaceAbelianCechComplexIso_of_productCharts,false,false),(`LinearStudy.nativeCechProductOpen,false,false),(`LinearStudy.nativeBaseSourceCechProductOpen,false,false),(`LinearStudy.nativeCechProductFace,false,false),(`LinearStudy.nativeBaseSourceCechProductFace,false,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_delete_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_general,false,false),(`LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso_general,false,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_delete_general,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_delete_general_typed,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_orderedFace_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductFamily_general,false,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductFamily_face_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechBuilder_general,false,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_general,false,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_general,false,false),(`LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso_general,false,false),(`LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso_general,false,false),(`LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso_general,false,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_general_eq_original,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_general_eq_original,true,true),(`LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso_general_eq_original,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_general_eq_original,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_general_eq_original,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso_general_eq_cached_original,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso_general_eq_original_factors,true,true)]
  let env ← Lean.getEnv
  for (n,want,wantTheorem) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
    let kernelKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | _ => "other"
    unless kernelKind == (if wantTheorem then "theorem" else "definition") do
      throwError m!"Incorrect kernel declaration kind: {n}"
    Lean.logInfo m!"KINDCHECK:{n}:{kernelKind}"
