@LinearStudy.cochainConeLiftTriangleEquation : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] [inst_2 : HasDerivedCategory A]
  (S : CategoryTheory.ShortComplex (CochainComplex A ℤ)) (K : CochainComplex A ℤ) (a : S.X₁ ⟶ K)
  (b : CochainComplex.HomComplex.Cochain S.X₂ K 0) (c : CochainComplex.HomComplex.Cocycle S.X₃ K 1),
  (CochainComplex.HomComplex.Cochain.ofHom S.f).comp b ⋯ = CochainComplex.HomComplex.Cochain.ofHom a →
    CochainComplex.HomComplex.δ 0 1 b = (CochainComplex.HomComplex.Cochain.ofHom S.g).comp ↑c ⋯ →
      CategoryTheory.CategoryStruct.comp (DerivedCategory.Q.map (CochainComplex.mappingCone.triangle S.f).mor₃)
          (CategoryTheory.CategoryStruct.comp ((CategoryTheory.Functor.commShiftIso DerivedCategory.Q 1).hom.app S.X₁)
            ((CategoryTheory.shiftFunctor (DerivedCategory A) 1).map (DerivedCategory.Q.map a))) =
        -CategoryTheory.CategoryStruct.comp (DerivedCategory.Q.map (CochainComplex.mappingCone.descShortComplex S))
            (CategoryTheory.ShiftedHom.map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm c) DerivedCategory.Q)
'LinearStudy.cochainConeLiftTriangleEquation' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.cochainConeLiftTriangleEquation:true
