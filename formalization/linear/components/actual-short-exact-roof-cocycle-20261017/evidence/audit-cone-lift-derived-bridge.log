@LinearStudy.cochainDerivedMap_eq_of_classEq : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] [inst_2 : HasDerivedCategory A] {K L : CochainComplex A ℤ} {n : ℤ}
  (x y : CochainComplex.HomComplex.Cocycle K L n),
  CochainComplex.HomComplex.CohomologyClass.mk x = CochainComplex.HomComplex.CohomologyClass.mk y →
    CategoryTheory.ShiftedHom.map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm x) DerivedCategory.Q =
      CategoryTheory.ShiftedHom.map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm y) DerivedCategory.Q
'LinearStudy.cochainDerivedMap_eq_of_classEq' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.cochainConeLiftDerivedBridge : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] [inst_2 : HasDerivedCategory A]
  (S : CategoryTheory.ShortComplex (CochainComplex A ℤ)) (K : CochainComplex A ℤ)
  (a : CochainComplex.HomComplex.Cocycle S.X₁ K 0) (b : CochainComplex.HomComplex.Cochain S.X₂ K 0)
  (c : CochainComplex.HomComplex.Cocycle S.X₃ K 1),
  (CochainComplex.HomComplex.Cochain.ofHom S.f).comp b ⋯ = ↑a →
    CochainComplex.HomComplex.δ 0 1 b = (CochainComplex.HomComplex.Cochain.ofHom S.g).comp ↑c ⋯ →
      CategoryTheory.ShiftedHom.map
          (CochainComplex.HomComplex.Cocycle.equivHomShift.symm ((CochainComplex.mappingCone.fst S.f).postcomp a.homOf))
          DerivedCategory.Q =
        CategoryTheory.ShiftedHom.map
          (CochainComplex.HomComplex.Cocycle.equivHomShift.symm
            (c.precomp (CochainComplex.mappingCone.descShortComplex S)))
          DerivedCategory.Q
'LinearStudy.cochainConeLiftDerivedBridge' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.cochainConeTriangle_mor3_neg_fst : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] {K L : CochainComplex A ℤ} (f : K ⟶ L),
  (CochainComplex.mappingCone.triangle f).mor₃ =
    CochainComplex.HomComplex.Cocycle.equivHomShift.symm (-CochainComplex.mappingCone.fst f)
'LinearStudy.cochainConeTriangle_mor3_neg_fst' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.cochainDerivedMap_eq_of_classEq:true
ROLECHECK:LinearStudy.cochainConeLiftDerivedBridge:true
ROLECHECK:LinearStudy.cochainConeTriangle_mor3_neg_fst:true
