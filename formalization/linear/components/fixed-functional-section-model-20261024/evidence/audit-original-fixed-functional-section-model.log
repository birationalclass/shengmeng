    [Algebra.FiniteType K S] [Module.Finite (MvPolynomial σ K) S] {τ : Type} (P : MvPolynomial τ K →ₐ[K] S)
    (I : Ideal (MvPolynomial τ K)) (m : ℕ)
    (e : ↑((ModuleCat.coextendScalars (algebraMap (MvPolynomial σ K) S)).obj ↧(MvPolynomial σ K)) →ₗ[S] S) {κ : Type}
    (c : κ → S) (hc : ∀ (i : κ), c i ∈ B 1) (hgenC : Algebra.adjoin K (Set.range c) = ⊤) (q : ℕ)
    (hcard : Fintype.card σ = q + 2) =>
  let A := MvPolynomial.homogeneousSubmodule σ K;
  let D := LinearStudy.nativeProjectiveRingIntegerPiece B;
  let C := (ModuleCat.coextendScalars (algebraMap (MvPolynomial σ K) S)).obj ↧(MvPolynomial σ K);
  have hR := ⋯;
  have hS := ⋯;
  let k := -↑(Fintype.card σ);
  let F := LinearStudy.nativeProjectiveModuleSheaf B D hS k;
  let H := LinearStudy.schemeModuleActualCohomology (AlgebraicGeometry.Proj B) F (q + 1);
  have piB :=
    CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Proj.toSpecZero B)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(B 0))));
  let W := ↥(LinearStudy.integerGradedHomPiece A D (k - k));
  have J := LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso B D hR hS c hc hgenC q hcard k;
  have comparison := LinearStudy.actualAbelianIsoAddEquiv J;
  ∀ (ell : H →+ K),
    (∀ (a : K) (x : H),
        ell
            ((CategoryTheory.Sheaf.H.map
                ((LinearStudy.schemeModuleToActualAbelianSheaf (AlgebraicGeometry.Proj B)).map
                  (LinearStudy.originalGlobalModuleScalar
                    ((CategoryTheory.ConcreteCategory.hom (AlgebraicGeometry.Scheme.Hom.appTop piB))
                      ((CategoryTheory.ConcreteCategory.hom (AlgebraicGeometry.Scheme.ΓSpecIso ↧K).inv) a))
                    F))
                (q + 1))
              x) =
          a * ell x) →
      ell ≠ 0 →
        ∃ z ∈ LinearStudy.coextensionGradedPiece A B 0,
          z ≠ 0 ∧
            ∃ (Q : MvPolynomial τ K),
              Q.IsHomogeneous m ∧
                Q ∉ I ∧
                  P Q = e z ∧
                    ∃ (psi : W),
                      z = (LinearStudy.coextensionOriginalAdjoint ↑psi) 1 ∧ ∀ (x : H), (comparison x) psi = ell x
