fun {n : ℕ} (V : LinearStudy.IntegralProjectiveEquations n) (q : ℕ) (L : Fin (q + 2) → LinearStudy.CoordinateRing n)
    (hL : ∀ (i : Fin (q + 2)), MvPolynomial.IsHomogeneous (L i) 1)
