                        ((ModuleCat.coextendScalars (algebraMap R S)).obj ↧R)) ≃ₗ[K]
                  Module.Dual K (TensorProduct R K S) :=
fun {R S K : Type u} [CommRing R] [CommRing S] [CommRing K] [Algebra R S] [Algebra R K] [Module.Free R S]
    [Module.Finite R S] =>
  (LinearEquiv.baseChange R K
        (↑((ModuleCat.restrictScalars (algebraMap R S)).obj ((ModuleCat.coextendScalars (algebraMap R S)).obj ↧R)))
        (Module.Dual R S) LinearStudy.coextensionOriginalDualEquiv).trans
    ⋯.toDualBaseChange
