  (f : ↥(LinearStudy.injectiveCocycleGroup I Q q)),
  (LinearStudy.schemeModuleInjectiveInternalHomClassMap I P q) ((LinearStudy.injectiveCocyclePrecompose I g q) f) =
    CategoryTheory.CategoryStruct.comp ((LinearStudy.schemeModuleInjectiveInternalHomClassMap I Q q) f)
      (HomologicalComplex.homologyMap (LinearStudy.schemeModuleHomCoefficientComplexMap g I.cocomplex) q)
'LinearStudy.schemeModuleInjectiveInternalHomClassMap_sourceNaturality' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
ROLECHECK:LinearStudy.schemeModuleInjectiveInternalHomCycleMap_sourceNaturality:true
ROLECHECK:LinearStudy.schemeModuleInjectiveInternalHomClassMap_sourceNaturality:true
