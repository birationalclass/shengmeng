LinearStudy.originalModuleScalarMorphism_eq_forget_smul_id.{u, v} {R : Type u} [CommRing R] (M : ModuleCat R) (r : R) :
  M.smul r = (CategoryTheory.forget₂ (ModuleCat R) AddCommGrpCat).map (r • CategoryTheory.CategoryStruct.id M)
'LinearStudy.originalModuleScalarMorphism_eq_forget_smul_id' depends on axioms: [propext, Classical.choice, Quot.sound]
