run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool × Bool) := [(`LinearStudy.originalIsoTransHom_of_eq,true,true),(`LinearStudy.originalEndomorphismSquare_of_comparison_eq,true,true),(`LinearStudy.originalAdditiveScalarSquare_apply,true,true),(`LinearStudy.originalAdditiveScalarSquare_of_apply,true,true),(`LinearStudy.originalScalarSquare_apply_of_calibrations,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_moduleActualHHom_factorization_composite_proof,true,false),(`LinearStudy.nativeFiniteNormalization_generalModuleCechActualHComposite_baseScalar_proof,true,false),(`LinearStudy.nativeFiniteNormalization_generalModuleCechActualH_baseScalar_apply_proof,true,false),(`LinearStudy.nativeFiniteNormalization_generalModuleCechActualH_baseScalar_proof,true,false),(`LinearStudy.nativeIndependentFiniteNormalization_publicActualHHom_factorization_composite_proof,true,false),(`LinearStudy.nativeIndependentFiniteNormalization_publicActualHComposite_baseScalar_general_proof,true,false),(`LinearStudy.nativeIndependentFiniteNormalization_publicActualHComposite_baseScalar_general,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_publicActualHigherHIso_baseScalar_explicit_proof,true,false),(`LinearStudy.nativeIndependentFiniteNormalization_publicActualHigherHIso_baseScalar_general,true,true),(`LinearStudy.nativeOriginalActualHPublicScalarOperator_eq_raw,true,true),(`LinearStudy.nativeOriginalActualHPublicScalarOperator_apply_eq_raw_proof,true,false),(`LinearStudy.nativeFiniteGradedTwist_contextActualHigherHIso_baseScalar_value_proof,true,false),(`LinearStudy.nativeFiniteGradedTwist_publicActualHHom_apply_eq_original_proof,true,false),(`LinearStudy.nativeFiniteGradedTwist_publicActualHigherHIso_baseScalar_value_proof,true,false),(`LinearStudy.nativeFiniteGradedTwist_publicActualHigherHIso_baseScalar_square_proof,true,false),(`LinearStudy.nativeFiniteGradedTwist_publicActualHigherHIso_baseScalar_square,true,true)]
  let env ← Lean.getEnv
  for (n,want,wantTheorem) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
    let kernelKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | _ => "other"
    unless kernelKind == (if wantTheorem then "theorem" else "definition") do
      throwError m!"Incorrect kernel declaration kind: {n}"
    Lean.logInfo m!"KINDCHECK:{n}:{kernelKind}"
