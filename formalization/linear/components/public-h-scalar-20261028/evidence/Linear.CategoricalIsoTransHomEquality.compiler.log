LinearStudy.originalIsoTransHom_of_eq.{u, v} {C : Type u} [CategoryTheory.Category.{v, u} C] {X Y Z : C} {old : X ≅ Z}
  {e : X ≅ Y} {j : Y ≅ Z} (h : old = e ≪≫ j) : old.hom = CategoryTheory.CategoryStruct.comp e.hom j.hom
'LinearStudy.originalIsoTransHom_of_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
