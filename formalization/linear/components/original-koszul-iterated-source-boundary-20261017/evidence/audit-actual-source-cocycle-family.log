            (HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r r) ⟶ L.X ↑r) →
              (n : ℕ) → n ≤ r → (HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r n) ⟶ L.X ↑n) :=
