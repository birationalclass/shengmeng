    (t : CochainComplex.HomComplex.Cochain K L (↑r - 1))
    (ar : HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r r) ⟶ L.X ↑r) (n : ℕ) (hn : n ≤ r) =>
  if h : n < r then
    CategoryTheory.CategoryStruct.comp
      (HomologicalComplex.fromOpcycles K (LinearStudy.cochainSourceDegree r n)
        (LinearStudy.cochainSourceDegree r (n + 1)))
      (t.v (LinearStudy.cochainSourceDegree r (n + 1)) ↑n ⋯)
  else
    have he := ⋯;
    Eq.ndrec (motive := fun (n : ℕ) =>
