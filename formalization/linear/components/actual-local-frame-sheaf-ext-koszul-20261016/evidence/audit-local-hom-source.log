                  (CategoryTheory.CategoryStruct.comp (LinearStudy.schemeModuleHomRestrict P' P (Opposite.unop W).hom u)
                    ((LinearStudy.schemeModuleHomOverEquiv P N (Opposite.unop W).left).symm f)),
