def LinearStudy.schemeModuleFreeOverIso.{u} : {X : AlgebraicGeometry.Scheme} →
  (U : X.Opens) → (ι : Type u) → [Finite ι] → (SheafOfModules.free ι).over U ≅ SheafOfModules.free ι :=
fun {X : AlgebraicGeometry.Scheme} (U : X.Opens) (ι : Type u) [Finite ι] =>
  (SheafOfModules.mapFreeIso (SheafOfModules.overFunctor X.ringCatSheaf U) ι
      (LinearStudy.schemeModuleUnitOverIso X U).symm).symm
