@LinearStudy.projectivePulledOriginalKoszul_isZero_above : ∀ {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n)
  (V : LinearStudy.IntegralProjectiveEquations n) (L : Fin (r + 1) → LinearStudy.CoordinateRing n)
  (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1) (w : Fin (r + 1) → ℂ) (k : ℤ) (p : ℕ),
  r < p → CategoryTheory.Limits.IsZero ((LinearStudy.projectivePulledLinearKoszulComplex f V L hL w k).X p)
'LinearStudy.projectivePulledOriginalKoszul_isZero_above' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.projectivePulledOriginalKoszul_isZero_above:true
