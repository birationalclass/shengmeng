@LinearStudy.actualHomCocycleComp_shiftedHom : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] {F G K : CochainComplex A ℤ} {n m p : ℤ}
  (a : CochainComplex.HomComplex.Cocycle F G n) (b : CochainComplex.HomComplex.Cocycle G K m) (h : n + m = p),
  CochainComplex.HomComplex.Cocycle.equivHomShift.symm (LinearStudy.actualHomCocycleComp a b h) =
    CategoryTheory.ShiftedHom.comp (CochainComplex.HomComplex.Cocycle.equivHomShift.symm a)
      (CochainComplex.HomComplex.Cocycle.equivHomShift.symm b) ⋯
'LinearStudy.actualHomCocycleComp_shiftedHom' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.cochainConeLiftDerived_allDegrees : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] [inst_2 : HasDerivedCategory A]
  (S : CategoryTheory.ShortComplex (CochainComplex A ℤ)) (K : CochainComplex A ℤ) (q : ℤ)
  (a : CochainComplex.HomComplex.Cocycle S.X₁ K q) (b : CochainComplex.HomComplex.Cochain S.X₂ K q)
  (c : CochainComplex.HomComplex.Cocycle S.X₃ K (q + 1)),
  (CochainComplex.HomComplex.Cochain.ofHom S.f).comp b ⋯ = ↑a →
    CochainComplex.HomComplex.δ q (q + 1) b = (CochainComplex.HomComplex.Cochain.ofHom S.g).comp ↑c ⋯ →
      CategoryTheory.ShiftedHom.map
          (CochainComplex.HomComplex.Cocycle.equivHomShift.symm
            (c.precomp (CochainComplex.mappingCone.descShortComplex S)))
          DerivedCategory.Q =
        (q.negOnePow •
              CategoryTheory.ShiftedHom.comp
                (CochainComplex.HomComplex.Cocycle.equivHomShift.symm (CochainComplex.mappingCone.fst S.f))
                (CochainComplex.HomComplex.Cocycle.equivHomShift.symm a) ⋯).map
          DerivedCategory.Q
'LinearStudy.cochainConeLiftDerived_allDegrees' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.cochainConeLiftTriangle_allDegrees : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
  [inst_1 : CategoryTheory.Abelian A] [inst_2 : HasDerivedCategory A]
  (S : CategoryTheory.ShortComplex (CochainComplex A ℤ)) (K : CochainComplex A ℤ) (q : ℤ)
  (a : CochainComplex.HomComplex.Cocycle S.X₁ K q) (b : CochainComplex.HomComplex.Cochain S.X₂ K q)
  (c : CochainComplex.HomComplex.Cocycle S.X₃ K (q + 1)),
  (CochainComplex.HomComplex.Cochain.ofHom S.f).comp b ⋯ = ↑a →
    CochainComplex.HomComplex.δ q (q + 1) b = (CochainComplex.HomComplex.Cochain.ofHom S.g).comp ↑c ⋯ →
      CategoryTheory.ShiftedHom.map
          (CochainComplex.HomComplex.Cocycle.equivHomShift.symm
            (c.precomp (CochainComplex.mappingCone.descShortComplex S)))
          DerivedCategory.Q =
        ((q + 1).negOnePow •
              CategoryTheory.ShiftedHom.comp (CochainComplex.mappingCone.triangle S.f).mor₃
                (CochainComplex.HomComplex.Cocycle.equivHomShift.symm a) ⋯).map
          DerivedCategory.Q
'LinearStudy.cochainConeLiftTriangle_allDegrees' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.actualHomCocycleComp_shiftedHom:true
ROLECHECK:LinearStudy.cochainConeLiftDerived_allDegrees:true
ROLECHECK:LinearStudy.cochainConeLiftTriangle_allDegrees:true
