run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool) := [(`LinearStudy.moduleBaseSourceLocalizationEquiv_map,true),(`LinearStudy.originalLocalizedModuleRefinement_map,true),(`LinearStudy.nativeProjectiveChartRefinement_coefficient,true),(`LinearStudy.nativeGradedModuleAwayDegreeZero_coefficient_mem,true),(`LinearStudy.nativeGradedModuleAwayDegreeZeroCoefficientMap,false),(`LinearStudy.nativeProjectiveChartDegreeZeroSectionMap_coefficient,true),(`LinearStudy.nativeBaseSourceWeightedChartSection_coefficient,true),(`LinearStudy.surjectiveCalibratedComparison_naturality,true),(`LinearStudy.nativeWeightedSourceAmbientSectionAddEquiv_coefficient,true),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_coefficient,true),(`LinearStudy.additiveEquivIso_coefficient,true),(`LinearStudy.abelianOpenSectionComparisonIso_coefficient,true),(`LinearStudy.orderedCrossSpaceAbelianCechComplexIso_coefficient,true),(`LinearStudy.nativeProjectiveDegreeZeroActualAbelian_app,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_coefficient,true),(`LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso_coefficient,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_coefficient,true),(`LinearStudy.nativeProjectiveTwistRegradingIso_coefficient_hom,true),(`LinearStudy.nativeProjectiveTwistRegradingIso_coefficient_inv,true),(`LinearStudy.nativeOrderedCechRegradingIso_coefficient_hom,true),(`LinearStudy.nativeOrderedCechRegradingIso_coefficient_inv,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_coefficient,true),(`LinearStudy.originalComparisonIsoCoefficientSquare_of_factorizations,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_homology_coefficient,true),(`LinearStudy.nativeFiniteGradedTwist_actualHigherHIso_coefficient,true),(`LinearStudy.schemeModuleActualHObject,false),(`LinearStudy.schemeModuleActualHCoefficientHom,false),(`LinearStudy.schemeModuleActualHObject_eq_original,true),(`LinearStudy.schemeModuleActualHObject_carrier_eq_original,true),(`LinearStudy.schemeModuleActualHCoefficientHom_eq_original,true),(`LinearStudy.nativeProjectiveOrderedCechHomologyObject,false),(`LinearStudy.nativeProjectiveOrderedCechHomologyCoefficientHom,false),(`LinearStudy.nativeProjectiveOrderedCechHomologyCoefficientHom_eq_original,true),(`LinearStudy.nativeIndependentFiniteNormalization_cachedActualHigherHIso,false),(`LinearStudy.nativeIndependentFiniteNormalization_cachedActualHigherHIso_eq_original,true),(`LinearStudy.nativeIndependentFiniteNormalization_cachedCechHomologyIso,false),(`LinearStudy.nativeIndependentFiniteNormalization_cachedCechHomologyIso_coefficient,true),(`LinearStudy.nativeFiniteGradedTwist_cachedActualHigherHIso,false),(`LinearStudy.nativeFiniteGradedTwist_cachedActualHigherHIso_coefficient,true),(`LinearStudy.nativeIndependentFiniteNormalization_cachedActualHigherHIso_factorization,true),(`LinearStudy.nativeIndependentFiniteNormalization_cachedActualHigherHIso_coefficient,true),(`LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso_coefficient,true),(`LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso_coefficient,true)]
  let env ← Lean.getEnv
  for (n,want) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
    let kernelKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | _ => "other"
    unless kernelKind == (if want then "theorem" else "definition") do
      throwError m!"Incorrect kernel declaration kind: {n}"
    Lean.logInfo m!"KINDCHECK:{n}:{kernelKind}"
