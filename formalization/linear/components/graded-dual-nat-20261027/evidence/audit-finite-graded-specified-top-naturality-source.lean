run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool × Bool) := [(`MvPolynomial.coordinateNativeCechAbelianModelIso,false,false),(`MvPolynomial.coordinateNativeCechAbelianModelIso_coefficient,true,true),(`LinearStudy.integerGradedHomDualCoefficientHom,false,false),(`LinearStudy.integerGradedHomDualCoefficientHom_apply,true,true),(`MvPolynomial.coordinateNativeFiniteIntegerPresentationDataGradedHomDualIso_abelian_naturality,true,false),(`MvPolynomial.coordinateNativeFiniteIntegerPresentationDataGradedHomDualAbelianIso,false,false),(`MvPolynomial.coordinateNativeFiniteIntegerPresentationDataGradedHomDualAbelianIso_factorization,true,true),(`MvPolynomial.coordinateNativeFiniteIntegerPresentationDataGradedHomDualAbelianIso_coefficient_proof,true,false),(`LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso_factorization_general,true,true),(`LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso_abelian_factorization_general,true,true),(`LinearStudy.originalSpecifiedDualityCoefficientSquare_of_sourceFactorizations,true,true),(`LinearStudy.originalSpecifiedDualityFactorizationData,false,false),(`LinearStudy.originalSpecifiedDualityFactorizationData_coefficient,true,true),(`LinearStudy.nativeFiniteNormalization_specifiedTopHomFactorizationData_general,false,false),(`LinearStudy.nativePolynomialFiniteNormalizationModuleHCoefficient_general,true,false),(`LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso_coefficient_with_variables_general,true,false),(`LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso_coefficient_general,true,false),(`LinearStudy.nativeFiniteNormalization_specifiedTopHomFactorizationData_specified_general,true,true),(`LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso_coefficient_general_typed,true,true)]
  let env ← Lean.getEnv
  for (n,want,wantTheorem) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
    let kernelKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | _ => "other"
    unless kernelKind == (if wantTheorem then "theorem" else "definition") do
      throwError m!"Incorrect kernel declaration kind: {n}"
    Lean.logInfo m!"KINDCHECK:{n}:{kernelKind}"
