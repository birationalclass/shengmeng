@LinearStudy.schemeModule_pullback_map_zero_iff_unit : ∀ {X Y : AlgebraicGeometry.Scheme} (f : Y ⟶ X) {A B : X.Modules}
  (a : A ⟶ B),
  CategoryTheory.CategoryStruct.comp a ((AlgebraicGeometry.Scheme.Modules.pullbackPushforwardAdjunction f).unit.app B) =
      0 ↔
    (AlgebraicGeometry.Scheme.Modules.pullback f).map a = 0
'LinearStudy.schemeModule_pullback_map_zero_iff_unit' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.schemeModule_pullback_map_zero_iff_unit:true
