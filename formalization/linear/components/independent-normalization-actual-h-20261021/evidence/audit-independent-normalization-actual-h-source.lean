#print LinearStudy.originalNormalization_actualOrderedCechHigherHIso
#print LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso
#print LinearStudy.originalNormalization_actualModuleCechHigherHIso
run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool) := [(`LinearStudy.nativeRingIntegerBaseGradeCompatibility,true),(`LinearStudy.nativeFiniteGradedIndependentCechProductSectionMap_surjective,true),(`LinearStudy.nativeFiniteGradedIndependentSourceCechProductSectionMap_bijective,true),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_delete,true),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso,false),(`LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_delete,true),(`LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso_face,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso,false),(`LinearStudy.nativeFiniteNormalization_sourceCoordinateCover,true),(`LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso,false),(`LinearStudy.originalNormalization_actualOrderedCechHigherHIso,false),(`LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso,false),(`LinearStudy.originalNormalization_actualModuleCechHigherHIso,false)]
  let env ← Lean.getEnv
  for (n,want) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
