#print axioms LinearStudy.nativeIndependentFiniteNormalization_actualHigherHIso
#check @LinearStudy.originalNormalization_actualOrderedCechHigherHIso
#print axioms LinearStudy.originalNormalization_actualOrderedCechHigherHIso
#check @LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso
#print axioms LinearStudy.nativeIndependentFiniteNormalization_moduleCechActualHigherHIso
#check @LinearStudy.originalNormalization_actualModuleCechHigherHIso
#print axioms LinearStudy.originalNormalization_actualModuleCechHigherHIso
#print LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv
#print LinearStudy.nativeIndependentSourceAmbientCechProductIso
#print LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso
#print LinearStudy.nativeIndependentSourceAmbientOrderedCechIso
#print LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso
