#check @LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_delete
#print axioms LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_delete
#check @LinearStudy.nativeIndependentSourceAmbientCechProductIso
#print axioms LinearStudy.nativeIndependentSourceAmbientCechProductIso
#check @LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso
#print axioms LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso
#check @LinearStudy.nativeIndependentSourceAmbientCechProductIso_delete
#print axioms LinearStudy.nativeIndependentSourceAmbientCechProductIso_delete
#check @LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso_face
#print axioms LinearStudy.nativeIndependentSourceAmbientCechIntersectionIso_face
#check @LinearStudy.nativeIndependentSourceAmbientOrderedCechIso
#print axioms LinearStudy.nativeIndependentSourceAmbientOrderedCechIso
#check @LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso
#print axioms LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso
