run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool × Bool) := [(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_smul_general_proof,true,false),(`LinearStudy.originalScalarComparison_of_calibrations,true,true),(`LinearStudy.projBasicOpenBaseScalar_eq_normalizationChart,true,true),(`LinearStudy.nativeWeightedSourceAmbientSectionAddEquiv_originalBaseScalar_proof,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_originalBaseScalar_general_proof,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechSectionAddEquiv_baseScalar_general_typed,true,true),(`LinearStudy.nativeProjectiveOriginalScalarPointwiseActual,true,false),(`LinearStudy.nativeProjectiveOriginalScalarPointwiseBothActual,true,false),(`LinearStudy.nativeProjectiveOriginalScalarSourceBuilder,true,false),(`LinearStudy.nativeProjectiveOriginalScalarTargetBuilder,true,false),(`LinearStudy.nativeProjectiveOriginalScalarSquare,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_baseScalar_general_proof,true,false),(`LinearStudy.nativeIndependentSourceAmbientCechProductIso_baseScalar_general,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_baseScalar_general_proof,true,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedCechIso_baseScalar_general,true,true),(`LinearStudy.orderedTopAbelianCechCoefficientIso_moduleScalar_hom,true,true),(`LinearStudy.orderedTopAbelianCechCoefficientIso_moduleScalar_inv,true,true),(`LinearStudy.nativeProjectiveOriginalBaseScalarMap,false,false),(`LinearStudy.nativeProjectiveOrderedBaseScalarMap,false,false),(`LinearStudy.nativeProjectiveOrderedCechRegrading_baseScalar_hom_square,true,false),(`LinearStudy.nativeProjectiveOrderedCechRegrading_baseScalar_inv_square,true,false),(`LinearStudy.nativeIndependentSourceAmbientShiftedZeroCechIso_baseScalar_general_square,true,false),(`LinearStudy.originalThreeIso_endomorphism_square,true,true),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_baseScalar_general_iso_proof,true,false),(`LinearStudy.nativeIndependentSourceAmbientOrderedTwistCechIso_baseScalar_general,true,true),(`LinearStudy.nativeIndependentFiniteNormalization_cachedCechHomologyIso_baseScalar_general,true,true),(`LinearStudy.nativeProjectiveOriginalScalarPointwise,true,false)]
  let env ← Lean.getEnv
  for (n,want,wantTheorem) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
    let kernelKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | _ => "other"
    unless kernelKind == (if wantTheorem then "theorem" else "definition") do
      throwError m!"Incorrect kernel declaration kind: {n}"
    Lean.logInfo m!"KINDCHECK:{n}:{kernelKind}"
