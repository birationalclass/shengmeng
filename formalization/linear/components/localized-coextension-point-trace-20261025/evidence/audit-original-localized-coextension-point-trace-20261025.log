fun {R S Q K : Type u} [CommRing R] [CommRing S] [CommRing Q] [CommRing K] [Algebra R S] [Algebra R Q] [Algebra R K]
    [Algebra Q K] [IsScalarTower R Q K] [Module.Finite R S] (P : Submonoid R) [IsLocalization P Q]
