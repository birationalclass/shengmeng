def LinearStudy.pointedExactFunctorExtMap.{u, v, u', v', w, w'} : {C : Type u} →
  [inst : CategoryTheory.Category.{v, u} C] →
    [inst_1 : CategoryTheory.Abelian C] →
      [inst_2 : CategoryTheory.HasExt C] →
        {D : Type u'} →
          [inst_3 : CategoryTheory.Category.{v', u'} D] →
            [inst_4 : CategoryTheory.Abelian D] →
              [inst_5 : CategoryTheory.HasExt D] →
                (F : CategoryTheory.Functor C D) →
                  [F.Additive] →
                    [CategoryTheory.Limits.PreservesFiniteLimits F] →
                      [CategoryTheory.Limits.PreservesFiniteColimits F] →
                        {O : C} →
                          {P : D} →
                            (P ⟶ F.obj O) →
                              (M : C) →
                                (n : ℕ) →
                                  CategoryTheory.Abelian.Ext O M n →+ CategoryTheory.Abelian.Ext P (F.obj M) n :=
fun {C : Type u} [CategoryTheory.Category.{v, u} C] [CategoryTheory.Abelian C] [CategoryTheory.HasExt C] {D : Type u'}
    [CategoryTheory.Category.{v', u'} D] [CategoryTheory.Abelian D] [CategoryTheory.HasExt D]
    (F : CategoryTheory.Functor C D) [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
    [CategoryTheory.Limits.PreservesFiniteColimits F] {O : C} {P : D} (e : P ⟶ F.obj O) (M : C) (n : ℕ) =>
  ((CategoryTheory.Abelian.Ext.mk₀ e).precomp (F.obj M) ⋯).comp (F.mapExtAddHom O M n)
def LinearStudy.schemeModuleIntegerToUnderlyingUnit.{u} : (X : AlgebraicGeometry.Scheme) →
  (CategoryTheory.constantSheaf (Opens.grothendieckTopology ↥X) AddCommGrpCat).obj ↧(ULift.{u, 0} ℤ) ⟶
    (LinearStudy.schemeModuleToAdditiveSheaf X).obj (SheafOfModules.unit X.ringCatSheaf) :=
fun (X : AlgebraicGeometry.Scheme) =>
  (LinearStudy.topAbelianSheafIntegerHomSectionsAddEquiv (↑X.toPresheafedSpace)
        ((LinearStudy.schemeModuleToAdditiveSheaf X).obj (SheafOfModules.unit X.ringCatSheaf))).symm
    1
def LinearStudy.schemeModuleGlobalExtActualHMap.{u} : (X : AlgebraicGeometry.Scheme) →
  (M : X.Modules) →
    (n : ℕ) →
      CategoryTheory.Abelian.Ext (SheafOfModules.unit X.ringCatSheaf) M n →+
        LinearStudy.schemeModuleActualCohomology X M n :=
fun (X : AlgebraicGeometry.Scheme) (M : X.Modules) (n : ℕ) =>
  LinearStudy.pointedExactFunctorExtMap (LinearStudy.schemeModuleToAdditiveSheaf X)
    (LinearStudy.schemeModuleIntegerToUnderlyingUnit X) M n
def LinearStudy.schemeModuleGlobalExtActualHAddEquiv.{u} : (X : AlgebraicGeometry.Scheme) →
  (M : X.Modules) →
    (n : ℕ) →
      CategoryTheory.Abelian.Ext (SheafOfModules.unit X.ringCatSheaf) M n ≃+
        LinearStudy.schemeModuleActualCohomology X M n :=
fun (X : AlgebraicGeometry.Scheme) (M : X.Modules) (n : ℕ) =>
  AddEquiv.ofBijective (LinearStudy.schemeModuleGlobalExtActualHMap X M n) ⋯
