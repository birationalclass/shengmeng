@LinearStudy.relativeAcyclicCovariantBoundary_surjective : ∀ {A : Type u_1}
  [inst : CategoryTheory.Category.{u_2, u_1} A] [inst_1 : CategoryTheory.Abelian A] [inst_2 : CategoryTheory.HasExt A]
  (O : A) {S : CategoryTheory.ShortComplex A} (hS : S.ShortExact) (n m : ℕ) (hm : n + 1 = m)
  [Subsingleton (CategoryTheory.Abelian.Ext O S.X₂ m)], Function.Surjective ⇑(hS.extClass.postcomp O hm)
'LinearStudy.relativeAcyclicCovariantBoundary_surjective' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.relativeAcyclicCovariantBoundary_injective : ∀ {A : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} A]
