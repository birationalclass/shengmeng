@LinearStudy.additiveFunctorExtendSingleIso_compatibility : ∀ {A : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} A] [inst_1 : CategoryTheory.Preadditive A]
  [inst_2 : CategoryTheory.Limits.HasZeroObject A] {B : Type u_4} [inst_3 : CategoryTheory.Category.{u_3, u_4} B]
  [inst_4 : CategoryTheory.Preadditive B] [inst_5 : CategoryTheory.Limits.HasZeroObject B]
  (F : CategoryTheory.Functor A B) [inst_6 : F.Additive] {ι : Type u_5} {ι' : Type u_6} {c : ComplexShape ι}
  {c' : ComplexShape ι'} [inst_7 : DecidableEq ι] [inst_8 : DecidableEq ι'] (e : c.Embedding c') (E : A) (i : ι)
  (i' : ι') (h : e.f i = i'),
  CategoryTheory.CategoryStruct.comp
      ((F.mapHomologicalComplex c').map (HomologicalComplex.extendSingleIso e E i i' h).hom)
      ((HomologicalComplex.singleMapHomologicalComplex F c' i').hom.app E) =
    CategoryTheory.CategoryStruct.comp
      (LinearStudy.additiveFunctorExtendComplexIso F ((HomologicalComplex.single A c i).obj E) e).hom
      (CategoryTheory.CategoryStruct.comp
        (HomologicalComplex.extendMap ((HomologicalComplex.singleMapHomologicalComplex F c i).hom.app E) e)
        (HomologicalComplex.extendSingleIso e (F.obj E) i i' h).hom)
