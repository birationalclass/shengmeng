  [inst_5 : CategoryTheory.Limits.HasZeroObject B] (F : CategoryTheory.Functor A B) [inst_6 : F.Additive] {ι : Type u_5}
  {c : ComplexShape ι} {C D : HomologicalComplex A c} (phi : C ⟶ D) (i : Option ι),
  CategoryTheory.CategoryStruct.comp (F.map (HomologicalComplex.extend.mapX phi i))
      (LinearStudy.additiveFunctorExtendXIso F D i).hom =
