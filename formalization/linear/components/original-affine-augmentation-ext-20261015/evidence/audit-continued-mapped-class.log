@LinearStudy.mappedCochainResolutionTopCocycle : ∀ {A : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} A]
  [inst_1 : CategoryTheory.Abelian A] {B : Type u_4} [inst_2 : CategoryTheory.Category.{u_3, u_4} B]
  [inst_3 : CategoryTheory.Abelian B] (F : CategoryTheory.Functor A B) [inst_4 : F.Additive] (K : CochainComplex A ℤ)
  {M : A} (r : ℕ) (a : K.X (-↑r) ⟶ M) (ha : CategoryTheory.CategoryStruct.comp (K.d (-↑r - 1) (-↑r)) a = 0),
  LinearStudy.mappedCochainResolutionCocycle F K r
      (CochainComplex.HomComplex.Cocycle.equivHomShift.symm
        (CochainComplex.HomComplex.Cocycle.toSingleMk a ⋯ (-↑r - 1) ⋯ ha)) =
    CochainComplex.HomComplex.Cocycle.equivHomShift.symm
      (CochainComplex.HomComplex.Cocycle.toSingleMk (F.map a) ⋯ (-↑r - 1) ⋯ ⋯)
'LinearStudy.mappedCochainResolutionTopCocycle' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.mappedOriginalChainTopCocycle : ∀ {A : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} A]
  [inst_1 : CategoryTheory.Abelian A] {B : Type u_4} [inst_2 : CategoryTheory.Category.{u_3, u_4} B]
  [inst_3 : CategoryTheory.Abelian B] (F : CategoryTheory.Functor A B) [inst_4 : F.Additive] (C : ChainComplex A ℕ)
  {M : A} (r : ℕ) (a : C.X r ⟶ M) (ha : CategoryTheory.CategoryStruct.comp (C.d (r + 1) r) a = 0),
  LinearStudy.mappedCochainResolutionCocycle F (LinearStudy.originalChainAsCochain C) r
      (LinearStudy.originalChainTopShiftedCocycle C r a ha) =
    CategoryTheory.CategoryStruct.comp (LinearStudy.additiveFunctorOriginalChainCochainIso F C).hom
      (LinearStudy.originalChainTopShiftedCocycle ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj C) r (F.map a) ⋯)
'LinearStudy.mappedOriginalChainTopCocycle' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.mappedOriginalChainAugmentation_quasiIso : ∀ {A : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} A]
