LinearStudy.originalDegreeVeroneseIndexedAffineIso.{u, v} {K : Type u} {S : Type v} [Field K] [CommRing S] [Algebra K S]
  (B : ℕ → Submodule K S) [GradedAlgebra B] (q : ℕ) [hq : Fact (0 < q)]
  (i : LinearStudy.OriginalDegreeVeroneseChartIndex B q) :
  AlgebraicGeometry.Spec ((LinearStudy.originalDegreeVeroneseAmbientAffineCover B q).X i) ≅
