'LinearStudy.schemeModuleInternalExtSourceFunctor_additive' depends on axioms: [propext, Classical.choice, Quot.sound]
def LinearStudy.schemeModuleInternalExtSourceFunctor.{u} : (X : AlgebraicGeometry.Scheme) →
  X.Modules → ℕ → CategoryTheory.Functor X.Modulesᵒᵖ X.Modules :=
fun (X : AlgebraicGeometry.Scheme) (N : X.Modules) (q : ℕ) =>
  { obj := fun (P : X.Modulesᵒᵖ) => LinearStudy.schemeModuleInternalExt (Opposite.unop P) N q,
    map := fun {X_1 Y : X.Modulesᵒᵖ} (f : X_1 ⟶ Y) => LinearStudy.schemeModuleInternalExtSourceMap f.unop N q,
    map_id := ⋯, map_comp := ⋯ }
