  (K : CochainComplex X.Modules ℕ),
  LinearStudy.schemeModuleHomCoefficientComplexMap (f + g) K =
    LinearStudy.schemeModuleHomCoefficientComplexMap f K + LinearStudy.schemeModuleHomCoefficientComplexMap g K
