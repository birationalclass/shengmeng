@LinearStudy.schemeModuleInternalExtSourceMap_add : ∀ {X : AlgebraicGeometry.Scheme} {A B : X.Modules} (f g : A ⟶ B)
  (N : X.Modules) (q : ℕ),
  LinearStudy.schemeModuleInternalExtSourceMap (f + g) N q =
