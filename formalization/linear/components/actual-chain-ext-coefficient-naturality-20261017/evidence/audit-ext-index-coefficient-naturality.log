  (P : ℕ → X.Modules) (i j : ℕ) (h : i = j) {N M : X.Modules} (c : N ⟶ M) (q : ℕ),
  CategoryTheory.CategoryStruct.comp ((LinearStudy.schemeModuleInternalExtFunctor (P i) q).map c)
