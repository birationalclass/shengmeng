run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool) := [(`LinearStudy.adjunction_unitProjection_eq_adjoint,true),(`LinearStudy.schemeModuleSupportedRestrictionIso_projection_adjoint,true),(`LinearStudy.schemeModuleMappedCokernelProjectionAdjoint,true),(`LinearStudy.chainCokernelProjectionInvariant,false),(`LinearStudy.mappedChainFirstCokernelPresentationIso_projectionInvariant,true),(`LinearStudy.mappedChainPresentationData,false),(`LinearStudy.mappedChainPresentationDataIso,false),(`LinearStudy.mappedChainPresentationData_projection,true),(`LinearStudy.schemeModuleMappedPresentationDataGlobalIso,false),(`LinearStudy.schemeModuleMappedPresentationDataGlobalProjection,false),(`LinearStudy.schemeModuleMappedPresentationDataGlobalIso_projection,true),(`LinearStudy.schemeModuleCokernelRestrictionUnit_isIso_of_complex_eq,true),(`LinearStudy.nativeProjectiveKoszulMappedTildeAffineIso,false),(`LinearStudy.nativeProjectiveKoszulMappedPresentationData,false),(`LinearStudy.nativeProjectiveKoszulPresentationProjectionProof,true),(`LinearStudy.nativeProjectiveKoszulMappedPresentationData_source,true),(`LinearStudy.nativeProjectiveKoszulMappedPresentationData_quotientTarget,true),(`LinearStudy.nativeProjectiveKoszulPresentationGlobalProjectionProof,true),(`LinearStudy.schemeModuleMappedPresentationDataGlobalProjection_exists,true),(`LinearStudy.parameterFamily_of_cover,true),(`LinearStudy.nativeProjectiveKoszulPresentationGlobalProjectionExistsProof,true),(`LinearStudy.projectivePulledLinearKoszulAmbientCover,false),(`LinearStudy.projectivePulledLinearSection_exists_presentationAmbientCover,true),(`LinearStudy.projectivePulledLinearKoszulGlobalProjectionExistsProof,true),(`LinearStudy.projectivePulledLinearSectionGlobalProjectionFamilyProof,true)]
  let env ← Lean.getEnv
  for (n,expected) in checks do
    let some info := env.find? n | throwError "Missing audited declaration"
    let isProof ← Lean.Meta.isProp info.type
    unless isProof == expected do
      throwError m!"Wrong semantic declaration role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{expected}"
