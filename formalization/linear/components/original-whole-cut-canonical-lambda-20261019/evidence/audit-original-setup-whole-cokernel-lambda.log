@LinearStudy.parameterPolynomialFamily_intersection : ∀ {R : Type u_1} [inst : CommRing R] [IsDomain R] [Infinite R]
  {s : Type u_2} {P Q : (s → R) → Prop},
  (∃ (c : MvPolynomial s R),
      c ≠ 0 ∧ (∃ (w : s → R), (MvPolynomial.eval w) c ≠ 0) ∧ ∀ (w : s → R), (MvPolynomial.eval w) c ≠ 0 → P w) →
    (∃ (c : MvPolynomial s R),
        c ≠ 0 ∧ (∃ (w : s → R), (MvPolynomial.eval w) c ≠ 0) ∧ ∀ (w : s → R), (MvPolynomial.eval w) c ≠ 0 → Q w) →
      ∃ (c : MvPolynomial s R),
        c ≠ 0 ∧ (∃ (w : s → R), (MvPolynomial.eval w) c ≠ 0) ∧ ∀ (w : s → R), (MvPolynomial.eval w) c ≠ 0 → P w ∧ Q w
'LinearStudy.parameterPolynomialFamily_intersection' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.projectivePulledOriginalSetupWholeTopCokernelLambdaFamilyProof : ∀ {n r : ℕ},
  0 < r →
    ∀ (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n),
      r < n →
        0 < f.degree →
          Function.Surjective f.onPoints →
            f.onPoints ⁻¹' V.zeroSet = V.zeroSet →
              ∀ (L : Fin (r + 1) → LinearStudy.CoordinateRing n)
                (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1),
                Function.Injective ⇑(LinearStudy.projectiveLinearNormalizationMap V L) →
                  (LinearStudy.projectiveLinearNormalizationMap V L).Finite →
                    ∀ (x0 : Fin n → ℂ),
                      LinearStudy.normalizedProjectivePoint x0 ∈ V.zeroSet →
                        ∃ (c : MvPolynomial (Fin (r + 1)) ℂ),
                          c ≠ 0 ∧
                            (∃ (w : Fin (r + 1) → ℂ), (MvPolynomial.eval w) c ≠ 0) ∧
                              ∀ (w : Fin (r + 1) → ℂ),
                                (MvPolynomial.eval w) c ≠ 0 →
                                  (∀ (i : ℤ),
                                      ∃ (e :
                                        CategoryTheory.Limits.cokernel
                                            ((LinearStudy.projectivePulledLinearKoszulComplex f V L hL w i).d 1 0) ≅
                                          LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w i)
                                        (he :
                                        QuasiIso
                                          (LinearStudy.originalChainCokernelTargetAugmentation
                                            (LinearStudy.projectivePulledLinearKoszulComplex f V L hL w i)
                                            (LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w i) e)),
                                        (LinearStudy.originalChainCokernelTargetAugmentation
                                                  (LinearStudy.projectivePulledLinearKoszulComplex f V L hL w i)
                                                  ((AlgebraicGeometry.Scheme.Modules.pushforward
                                                        (LinearStudy.projectivePulledLinearSectionClosedEmbedding f V L
                                                          hL w)).obj
                                                    (LinearStudy.nativeProjectiveModuleSheaf
                                                      (LinearStudy.homogeneousQuotientPiece
                                                        (LinearStudy.projectivePulledLinearSectionIdeal f V L w))
                                                      (LinearStudy.nativeProjectiveRingIntegerPiece
                                                        (LinearStudy.homogeneousQuotientPiece
                                                          (LinearStudy.projectivePulledLinearSectionIdeal f V L w)))
                                                      ⋯ i))
                                                  e).f
                                              0 =
                                            CategoryTheory.CategoryStruct.comp
                                              (CategoryTheory.Limits.cokernel.π
                                                ((LinearStudy.projectivePulledLinearKoszulComplex f V L hL w i).d 1 0))
                                              e.hom ∧
                                          LinearStudy.projectivePulledOriginalWholeTopCokernelStatement f V L hL w i e
                                            he) ∧
                                    ∀ (k : ℤ), LinearStudy.projectivePulledOriginalCokernelLambdaStatement f V L hL w k
