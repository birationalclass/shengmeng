@LinearStudy.noetherian_artinRees_kernel_restriction : ∀ {R P N : Type u_1} [inst : CommRing R] [IsNoetherianRing R]
  [inst_2 : AddCommGroup P] [inst_3 : Module R P] [Module.Finite R P] [inst_5 : AddCommGroup N] [inst_6 : Module R N]
  (J : Ideal R) (f : P →ₗ[R] R) (g : P →ₗ[R] N),
  J • f.ker ≤ g.ker → ∃ (n : ℕ), 0 < n ∧ ∀ x ∈ J ^ n • ⊤, f x = 0 → g x = 0
'LinearStudy.noetherian_artinRees_kernel_restriction' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.injective_linearMap_extend_of_ker_le : ∀ {R P I : Type u_1} [inst : CommRing R] [inst_1 : AddCommGroup P]
  [inst_2 : Module R P] [inst_3 : AddCommGroup I] [inst_4 : Module R I] [Module.Injective R I] (f : P →ₗ[R] R)
  (g : P →ₗ[R] I), f.ker ≤ g.ker → ∃ (h : R →ₗ[R] I), h ∘ₗ f = g
'LinearStudy.injective_linearMap_extend_of_ker_le' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.finiteCompatibleFamily_ideal_kills_relations : ∀ {R I ι : Type u_1} [inst : CommRing R]
  [inst_1 : AddCommGroup I] [inst_2 : Module R I] [inst_3 : Fintype ι] (b : ι → R) (a : ι → I),
  (∀ (i j : ι), b j • a i = b i • a j) →
    Ideal.span (Set.range b) • (Fintype.linearCombination R b).ker ≤ (Fintype.linearCombination R a).ker
