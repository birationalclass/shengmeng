fun {n r : ℕ} (V : LinearStudy.IntegralProjectiveEquations n) (lower : ℕ) (hr : 0 < r) (hrn : r < n) =>
  Exists.imp
    (fun (m : ℕ)
        (hm :
          0 < m ∧
            lower ≤ m ∧
              ∀ (D : ℕ),
                1 ≤ D →
                  ∀ (f : LinearStudy.HomogeneousEndomorphism n),
                    m * D < f.degree →
                      ∀ (L : Fin (r + 1) → LinearStudy.CoordinateRing n)
                        (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1) (w : Fin (r + 1) → ℂ),
                        let t := ↑r * ↑f.degree - ↑r - 1;
                        ∀
                          (e :
                            CategoryTheory.Limits.cokernel
                                ((LinearStudy.projectivePulledLinearKoszulComplex f V L hL w t).d 1 0) ≅
                              LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w t)
                          (he :
                            QuasiIso
                              (LinearStudy.originalChainCokernelTargetAugmentation
                                (LinearStudy.projectivePulledLinearKoszulComplex f V L hL w t)
                                (LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w t) e)),
                          LinearStudy.projectivePulledOriginalCutActualSectionSequenceStatement f V L hL w e he) =>
      ⟨hm.left,
        ⟨hm.right.left,
          fun (D : ℕ) (hD : 1 ≤ D) (f : LinearStudy.HomogeneousEndomorphism n) (hd : m * D < f.degree)
            (hf : Function.Surjective f.onPoints) (hV : f.onPoints ⁻¹' V.zeroSet = V.zeroSet)
            (L : Fin (r + 1) → LinearStudy.CoordinateRing n)
            (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1)
            (hinj : Function.Injective ⇑(LinearStudy.projectiveLinearNormalizationMap V L))
            (hfinite : (LinearStudy.projectiveLinearNormalizationMap V L).Finite) (x0 : Fin n → ℂ)
            (hx0 : LinearStudy.normalizedProjectivePoint x0 ∈ V.zeroSet) =>
          LinearStudy.projectivePulledOriginalSetupCutActualSectionFamilyProof f V hrn
            (lt_of_le_of_lt (Nat.zero_le (m * D)) hd) hf hV L hL hinj hfinite x0 hx0
            fun (w : Fin (r + 1) → ℂ)
              (e :
                CategoryTheory.Limits.cokernel
                    ((LinearStudy.projectivePulledLinearKoszulComplex f V L hL w (↑r * ↑f.degree - ↑r - 1)).d 1 0) ≅
                  LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w (↑r * ↑f.degree - ↑r - 1))
              (he :
                QuasiIso
                  (LinearStudy.originalChainCokernelTargetAugmentation
                    (LinearStudy.projectivePulledLinearKoszulComplex f V L hL w (↑r * ↑f.degree - ↑r - 1))
                    (LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w (↑r * ↑f.degree - ↑r - 1)) e)) =>
            hm.right.right D hD f hd L hL w e he⟩⟩)
    (LinearStudy.projectivePulledOriginal_uniformCutActualSectionSequence_above V lower hr)
