fun {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n) (hrn : r < n)
    (hq : 0 < f.degree) (hf : Function.Surjective f.onPoints) (hV : f.onPoints ⁻¹' V.zeroSet = V.zeroSet)
    (L : Fin (r + 1) → LinearStudy.CoordinateRing n) (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1)
    (hinj : Function.Injective ⇑(LinearStudy.projectiveLinearNormalizationMap V L))
    (hfinite : (LinearStudy.projectiveLinearNormalizationMap V L).Finite) (x0 : Fin n → ℂ)
    (hx0 : LinearStudy.normalizedProjectivePoint x0 ∈ V.zeroSet) =>
  LinearStudy.parameterFamily_enrich_exists_proof
    (LinearStudy.projectivePulledLinearSectionOriginalSetupResolutionProof f V hrn hq hf hV L hL hinj hfinite x0 hx0)
    fun (w : Fin (r + 1) → ℂ) (k : ℤ)
      (e :
        CategoryTheory.Limits.cokernel ((LinearStudy.projectivePulledLinearKoszulComplex f V L hL w k).d 1 0) ≅
          LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w k)
      (he :
        QuasiIso
          (LinearStudy.originalChainCokernelTargetAugmentation
            (LinearStudy.projectivePulledLinearKoszulComplex f V L hL w k)
            (LinearStudy.projectivePulledWholeCutResolutionTarget f V L hL w k) e)) =>
    LinearStudy.projectivePulledOriginalWholeCutInjectiveStatement_proof f V L hL w k e he
