fun {A : Type u} [CategoryTheory.Category.{v, u} A] [CategoryTheory.Abelian A] (C : ChainComplex A ℕ) {E N : A} (r : ℕ)
    (alpha : C ⟶ (ChainComplex.single₀ A).obj E) (hAlpha : QuasiIso alpha) (a : C.X r ⟶ N)
    (ha : CategoryTheory.CategoryStruct.comp (C.d (r + 1) r) a = 0) =>
  ∀ (I : CategoryTheory.InjectiveResolution N),
    ∃ (c : CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor A 0).obj E) I.cochainComplex ↑r) (t :
      CochainComplex.HomComplex.Cochain (LinearStudy.originalChainAsCochain C) I.cochainComplex (↑r - 1)),
      CochainComplex.HomComplex.CohomologyClass.mk
            (c.precomp (LinearStudy.originalChainAugmentationAsCochain C alpha)) =
          CochainComplex.HomComplex.CohomologyClass.mk
            ((LinearStudy.originalChainOrderedTopCocycle C r a ha).postcomp I.ι') ∧
        CochainComplex.HomComplex.δ (↑r - 1) (↑r) t =
            ↑(c.precomp (LinearStudy.originalChainAugmentationAsCochain C alpha)) -
              ↑((LinearStudy.originalChainOrderedTopCocycle C r a ha).postcomp I.ι') ∧
          LinearStudy.originalChainTopExtClass C r alpha a ha =
            I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk c)
