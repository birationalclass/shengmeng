@LinearStudy.schemeModuleOriginalOpcycleBoundary_embedding : ∀ {X : AlgebraicGeometry.Scheme}
  (C : ChainComplex X.Modules ℕ) {E : X.Modules} (alpha : C ⟶ (ChainComplex.single₀ X.Modules).obj E)
  [inst : QuasiIso alpha] (N : X.Modules) (j : ℤ) (p : ℕ) (h : -↑p = j + 1) (q : ℕ),
  CategoryTheory.CategoryStruct.comp
      (LinearStudy.schemeModuleInternalExtSourceBoundary (LinearStudy.schemeModuleChainOpcycleSequence C p) ⋯ N q)
      (LinearStudy.schemeModuleInternalExtSourceMap (LinearStudy.schemeModuleOriginalOpcycleSourceIso C j p h).hom.τ₃ N
        (q + 1)) =
    CategoryTheory.CategoryStruct.comp
      (LinearStudy.schemeModuleInternalExtSourceMap (LinearStudy.schemeModuleOriginalOpcycleSourceIso C j p h).hom.τ₁ N
        q)
      (LinearStudy.schemeModuleInternalExtSourceBoundary
        (LinearStudy.cochainOpcycleSourceSequence (LinearStudy.originalChainAsCochain C) j) ⋯ N q)
'LinearStudy.schemeModuleOriginalOpcycleBoundary_embedding' depends on axioms: [propext, Classical.choice, Quot.sound]
def LinearStudy.schemeModuleHomShortComplexSourceMap.{u} : {X : AlgebraicGeometry.Scheme} →
  {S T : CategoryTheory.ShortComplex X.Modules} →
    (S ⟶ T) →
      (K : CochainComplex X.Modules ℕ) →
        LinearStudy.schemeModuleHomSourceShortComplex T K ⟶ LinearStudy.schemeModuleHomSourceShortComplex S K :=
fun {X : AlgebraicGeometry.Scheme} {S T : CategoryTheory.ShortComplex X.Modules} (phi : S ⟶ T)
    (K : CochainComplex X.Modules ℕ) =>
  { τ₁ := LinearStudy.schemeModuleHomCoefficientComplexMap phi.τ₃ K,
    τ₂ := LinearStudy.schemeModuleHomCoefficientComplexMap phi.τ₂ K,
    τ₃ := LinearStudy.schemeModuleHomCoefficientComplexMap phi.τ₁ K, comm₁₂ := ⋯, comm₂₃ := ⋯ }
