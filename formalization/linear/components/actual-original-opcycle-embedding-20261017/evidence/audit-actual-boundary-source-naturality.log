  {S T : CategoryTheory.ShortComplex X.Modules} (phi : S ⟶ T) (hS : S.ShortExact) (hT : T.ShortExact) (N : X.Modules)
  (I : CategoryTheory.InjectiveResolution N) (q : ℕ),
