  CategoryTheory.CategoryStruct.comp ((LinearStudy.schemeModuleHomToInternalExtZero S.X₁ N) a)
      (CategoryTheory.CategoryStruct.comp (LinearStudy.schemeModuleInternalExtSourceBoundaryViaResolution S hS N I 0)
        (LinearStudy.schemeModuleHomSourceBoundaryCokernelIso S hS N I hB).inv) =
    CategoryTheory.CategoryStruct.comp ((LinearStudy.schemeModuleHomUnitAddEquiv S.X₁ N).symm a)
      (CategoryTheory.Limits.cokernel.π (LinearStudy.schemeModuleHomPrecompose S.f))
