@LinearStudy.projectivePulledOriginalNamedExactChart_ring : ∀ {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n)
  (V : LinearStudy.IntegralProjectiveEquations n) (L : Fin (r + 1) → LinearStudy.CoordinateRing n)
  (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1) (w : Fin (r + 1) → ℂ) (k : ℤ),
  (LinearStudy.projectivePulledOriginalNamedExactChart f V L hL w k).fst =
    ↧(HomogeneousLocalization.Away (LinearStudy.homogeneousQuotientPiece V.ideal.toIdeal)
        ((Ideal.Quotient.mk V.ideal.toIdeal) (MvPolynomial.X 0)))
'LinearStudy.projectivePulledOriginalNamedExactChart_ring' depends on axioms: [propext, Classical.choice, Quot.sound]
@LinearStudy.projectivePulledOriginalNamedExactChart_inclusion : ∀ {n r : ℕ} (f : LinearStudy.HomogeneousEndomorphism n)
  (V : LinearStudy.IntegralProjectiveEquations n) (L : Fin (r + 1) → LinearStudy.CoordinateRing n)
  (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1) (w : Fin (r + 1) → ℂ) (k : ℤ),
  (LinearStudy.projectivePulledOriginalNamedExactChart f V L hL w k).snd.fst ≍ LinearStudy.originalProjectiveZeroChart V
'LinearStudy.projectivePulledOriginalNamedExactChart_inclusion' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@LinearStudy.projectivePulledOriginalNamedExactChart_awayInclusion : ∀ {n r : ℕ}
  (f : LinearStudy.HomogeneousEndomorphism n) (V : LinearStudy.IntegralProjectiveEquations n)
  (L : Fin (r + 1) → LinearStudy.CoordinateRing n) (hL : ∀ (i : Fin (r + 1)), MvPolynomial.IsHomogeneous (L i) 1)
  (w : Fin (r + 1) → ℂ) (k : ℤ),
  (LinearStudy.projectivePulledOriginalNamedExactChart f V L hL w k).snd.fst ≍
    AlgebraicGeometry.Proj.awayι (LinearStudy.homogeneousQuotientPiece V.ideal.toIdeal)
      ((Ideal.Quotient.mk V.ideal.toIdeal) (MvPolynomial.X 0)) ⋯ ⋯
'LinearStudy.projectivePulledOriginalNamedExactChart_awayInclusion' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@LinearStudy.projectivePulledOriginalAway_isOpenImmersion : ∀ {n : ℕ} (V : LinearStudy.IntegralProjectiveEquations n),
  AlgebraicGeometry.IsOpenImmersion
    (AlgebraicGeometry.Proj.awayι (LinearStudy.homogeneousQuotientPiece V.ideal.toIdeal)
      ((Ideal.Quotient.mk V.ideal.toIdeal) (MvPolynomial.X 0)) ⋯ ⋯)
'LinearStudy.projectivePulledOriginalAway_isOpenImmersion' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.projectivePulledOriginalNamedExactChart_ring:true
ROLECHECK:LinearStudy.projectivePulledOriginalNamedExactChart_inclusion:true
ROLECHECK:LinearStudy.projectivePulledOriginalNamedExactChart_awayInclusion:true
ROLECHECK:LinearStudy.projectivePulledOriginalAway_isOpenImmersion:true
