@LinearStudy.scheme_chart_image_top_eq_of_HEq : ∀ {X : AlgebraicGeometry.Scheme} {R S : CommRingCat}
  (j : AlgebraicGeometry.Spec R ⟶ X) [inst : AlgebraicGeometry.IsOpenImmersion j] (l : AlgebraicGeometry.Spec S ⟶ X)
  [inst_1 : AlgebraicGeometry.IsOpenImmersion l],
  R = S →
    j ≍ l → (AlgebraicGeometry.Scheme.Hom.opensFunctor j).obj ⊤ = (AlgebraicGeometry.Scheme.Hom.opensFunctor l).obj ⊤
'LinearStudy.scheme_chart_image_top_eq_of_HEq' depends on axioms: [propext, Classical.choice, Quot.sound]
ROLECHECK:LinearStudy.scheme_chart_image_top_eq_of_HEq:true
