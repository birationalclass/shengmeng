def LinearStudy.schemeModuleGlobalToInternalExtAll.{u} : {X : AlgebraicGeometry.Scheme} →
  (P N : X.Modules) →
    (q : ℕ) →
      CategoryTheory.Abelian.Ext P N q →+
        (SheafOfModules.unit X.ringCatSheaf ⟶ LinearStudy.schemeModuleInternalExt P N q) :=
fun {X : AlgebraicGeometry.Scheme} (P N : X.Modules) (q : ℕ) =>
  match q with
  | 0 => (LinearStudy.schemeModuleHomToInternalExtZero P N).comp CategoryTheory.Abelian.Ext.addEquiv₀.toAddMonoidHom
  | n.succ => LinearStudy.schemeModuleGlobalToInternalExt P N n
def LinearStudy.schemeModuleCochainInternalBoundaryStep.{u} : {X : AlgebraicGeometry.Scheme} →
  (K : CochainComplex X.Modules ℤ) →
    {E : X.Modules} →
      (N : X.Modules) →
        (r : ℕ) →
          (alpha : K ⟶ (CochainComplex.singleFunctor X.Modules 0).obj E) →
            [QuasiIso alpha] →
              (n : ℕ) →
                LinearStudy.schemeModuleInternalExt
                    (HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r n)) N n ⟶
                  LinearStudy.schemeModuleInternalExt
                    (HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r (n + 1))) N (n + 1) :=
fun {X : AlgebraicGeometry.Scheme} (K : CochainComplex X.Modules ℤ) {E : X.Modules} (N : X.Modules) (r : ℕ)
    (alpha : K ⟶ (CochainComplex.singleFunctor X.Modules 0).obj E) [QuasiIso alpha] (n : ℕ) =>
  if hn : n < r then
    LinearStudy.schemeModuleInternalExtSourceBoundary
      (LinearStudy.cochainOpcycleSourceSequence K (LinearStudy.cochainSourceDegree r n)) ⋯ N n
  else 0
def LinearStudy.schemeModuleCochainIteratedInternalBoundary.{u} : {X : AlgebraicGeometry.Scheme} →
  (K : CochainComplex X.Modules ℤ) →
    {E : X.Modules} →
      (N : X.Modules) →
        (r : ℕ) →
          (alpha : K ⟶ (CochainComplex.singleFunctor X.Modules 0).obj E) →
            [QuasiIso alpha] →
              (n : ℕ) →
                n ≤ r →
                  (LinearStudy.schemeModuleInternalExt
                      (HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r 0)) N 0 ⟶
                    LinearStudy.schemeModuleInternalExt
                      (HomologicalComplex.opcycles K (LinearStudy.cochainSourceDegree r n)) N n) :=
fun {X : AlgebraicGeometry.Scheme} (K : CochainComplex X.Modules ℤ) {E : X.Modules} (N : X.Modules) (r : ℕ)
    (alpha : K ⟶ (CochainComplex.singleFunctor X.Modules 0).obj E) [QuasiIso alpha] (n : ℕ) (hn : n ≤ r) =>
  CategoryTheory.Functor.OfSequence.map (LinearStudy.schemeModuleCochainInternalBoundaryStep K N r alpha) 0 n ⋯
