run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool) := [(`LinearStudy.schemeModuleGlobalScalar_ext_centrality,true),(`LinearStudy.schemeModuleUnitHomGlobalSections_symm_originalScalar,true),(`LinearStudy.schemeModuleExtClassActualSectionBoundary_originalScalar,true),(`LinearStudy.schemeModuleSectionsSpecModule,false),(`LinearStudy.schemeModuleSectionsSpecModule_smul,true),(`LinearStudy.schemeModuleExtClassActualSectionBoundarySpecLinearMap,false),(`LinearStudy.schemeModuleExtClassActualSectionBoundarySpecLinearMap_forget,true),(`LinearStudy.schemeModuleOriginalActualSectionBoundarySpecLinearMap,false),(`LinearStudy.schemeModuleOriginalActualSectionBoundarySpecLinearMap_forget,true),(`LinearStudy.schemeModuleOriginalActualSectionRelation_nonzero_descent,true),(`LinearStudy.nativeCoextensionSpecifiedTrace_original_section_relation_representative,true),(`LinearStudy.projectivePulledOriginalFixedTopNonzeroRelationStatement,false),(`LinearStudy.projectivePulledOriginalFixedTopNonzeroRelationStatement_of_exact,true),(`LinearStudy.projectivePulledOriginal_uniform_nonzero_relation_descent_above,true),(`LinearStudy.finiteAdditiveDual_exists_nonzero_representative,true),(`LinearStudy.nativeCoextensionSpecifiedTopDual_exists_nonzero_graded_representative,true),(`LinearStudy.coextensionOriginalAdjoint_ring_generator,true),(`LinearStudy.coextensionOriginalAdjoint_ring_one_ne_zero,true),(`LinearStudy.coextensionOriginalAdjoint_ring_one_mem_zero,true),(`LinearStudy.originalNormalizationDual_exists_fixed_polynomial_images_above,true),(`LinearStudy.nativeCoextensionSpecifiedTopDual_ring_exists_nonzero_zero_degree_element,true),(`LinearStudy.nativeCoextensionFixedPolynomialFunctionalStatement,false),(`LinearStudy.nativeCoextensionFixedPolynomialFunctionalStatement_of_images,true),(`LinearStudy.originalNormalization_exists_fixed_polynomial_of_top_functional_above,true),(`LinearStudy.nativeCoextensionFixedPolynomialRepresentativeStatement,false),(`LinearStudy.nativeCoextensionFixedPolynomialRepresentativeStatement_of_functional,true),(`LinearStudy.schemeModuleOriginalSectionRelationRepresentativeStatement,false),(`LinearStudy.schemeModuleOriginalSectionRelationRepresentativeStatement_of_exact,true),(`LinearStudy.nativeCoextensionOriginalRelationPolynomialStatement,false),(`LinearStudy.nativeCoextensionOriginalRelationPolynomialStatement_of_exact,true),(`LinearStudy.projectivePulledOriginalAnyTopActualSectionStatement,false),(`LinearStudy.projectivePulledOriginalAnyTopActualSectionStatement_of_bound,true),(`LinearStudy.projectivePulledOriginal_uniformAnyTopActualSectionExact_above,true),(`LinearStudy.originalProjectivePolynomialSection_nonzero_of_normalization,true)]
  let env ← Lean.getEnv
  for (n,want) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
    let kernelKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | _ => "other"
    unless kernelKind == (if want then "theorem" else "definition") do
      throwError m!"Incorrect kernel declaration kind: {n}"
    Lean.logInfo m!"KINDCHECK:{n}:{kernelKind}"
