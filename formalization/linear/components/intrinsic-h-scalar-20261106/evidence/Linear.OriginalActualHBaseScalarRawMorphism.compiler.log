LinearStudy.originalActualHBaseScalarRawMorphism.{u} {X S : AlgebraicGeometry.Scheme} (pi : X ⟶ S) (M : X.Modules)
  (n : ℕ) (r : ↑(S.presheaf.obj (Opposite.op ⊤))) :
  (LinearStudy.originalActualHBaseModuleObject pi M n).smul r =
    AddCommGrpCat.ofHom
      (CategoryTheory.Sheaf.H.map
        ((LinearStudy.schemeModuleToActualAbelianSheaf X).map
          (LinearStudy.originalGlobalModuleScalar
            ((CategoryTheory.ConcreteCategory.hom (AlgebraicGeometry.Scheme.Hom.appTop pi)) r) M))
        n)
'LinearStudy.originalActualHBaseScalarRawMorphism' depends on axioms: [propext, Classical.choice, Quot.sound]
