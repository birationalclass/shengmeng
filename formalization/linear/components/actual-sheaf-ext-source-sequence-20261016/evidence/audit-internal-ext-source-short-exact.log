def LinearStudy.schemeModuleHomCoefficientComplex.{u} : {X : AlgebraicGeometry.Scheme} →
  X.Modules → CochainComplex X.Modules ℕ → CochainComplex X.Modules ℕ :=
fun {X : AlgebraicGeometry.Scheme} (P : X.Modules) (K : CochainComplex X.Modules ℕ) =>
  ((LinearStudy.schemeModuleInternalHomCoefficientFunctor X P).mapHomologicalComplex (ComplexShape.up ℕ)).obj K
def LinearStudy.schemeModuleHomCoefficientComplexMap.{u} : {X : AlgebraicGeometry.Scheme} →
  {A B : X.Modules} →
    (A ⟶ B) →
      (K : CochainComplex X.Modules ℕ) →
        LinearStudy.schemeModuleHomCoefficientComplex B K ⟶ LinearStudy.schemeModuleHomCoefficientComplex A K :=
fun {X : AlgebraicGeometry.Scheme} {A B : X.Modules} (f : A ⟶ B) (K : CochainComplex X.Modules ℕ) =>
  (CategoryTheory.NatTrans.mapHomologicalComplex (LinearStudy.schemeModuleInternalHomSourceNatTrans f)
        (ComplexShape.up ℕ)).app
    K
def LinearStudy.schemeModuleHomSourceShortComplex.{u} : {X : AlgebraicGeometry.Scheme} →
  CategoryTheory.ShortComplex X.Modules →
    CochainComplex X.Modules ℕ → CategoryTheory.ShortComplex (CochainComplex X.Modules ℕ) :=
fun {X : AlgebraicGeometry.Scheme} (S : CategoryTheory.ShortComplex X.Modules) (K : CochainComplex X.Modules ℕ) =>
  { X₁ := LinearStudy.schemeModuleHomCoefficientComplex S.X₃ K,
    X₂ := LinearStudy.schemeModuleHomCoefficientComplex S.X₂ K,
    X₃ := LinearStudy.schemeModuleHomCoefficientComplex S.X₁ K,
    f := LinearStudy.schemeModuleHomCoefficientComplexMap S.g K,
    g := LinearStudy.schemeModuleHomCoefficientComplexMap S.f K, zero := ⋯ }
