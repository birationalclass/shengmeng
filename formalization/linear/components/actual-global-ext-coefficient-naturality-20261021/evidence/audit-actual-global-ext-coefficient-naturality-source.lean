run_cmd Lean.Elab.Command.liftTermElabM do
  let checks : List (Lean.Name × Bool) := [(`LinearStudy.relativeAcyclicContravariantBoundaryAddEquiv_coefficient_naturality,true),(`LinearStudy.relativeAcyclicContravariantBoundaryAddEquiv_symm_coefficient_naturality,true),(`LinearStudy.acyclicChainOpcycleGlobalExtShiftAddEquiv_coefficient_naturality,true),(`LinearStudy.extAddEquivIndexTransport_coefficient_naturality,true),(`LinearStudy.acyclicChainOpcycleIteratedGlobalExtAddEquiv_coefficient_naturality,true),(`LinearStudy.acyclicResolutionExtSourceIsoAddEquiv_coefficient_naturality,true),(`LinearStudy.acyclicResolutionGlobalExtOpcycleAddEquiv_coefficient_naturality,true),(`LinearStudy.acyclicChainOpcycleHomCokernelCoefficientMap,false),(`LinearStudy.acyclicChainOpcycleHomCokernelCoefficientMap_projection,true),(`LinearStudy.acyclicChainOpcycleHomGlobalExtBoundary_coefficient_naturality,true),(`LinearStudy.acyclicChainOpcycleHomGlobalExtCokernelIso_coefficient_naturality,true),(`LinearStudy.chainActualHomCochainCoefficientMap,false),(`LinearStudy.chainActualHomCyclesNativeIso_inv_coefficient_naturality,true),(`LinearStudy.chainActualHomCyclesOpcyclesIso_inv_coefficient_naturality,true),(`LinearStudy.chainActualHomCyclesOpcyclesIso_coefficient_naturality,true),(`LinearStudy.chainActualHomCochainHomologyCokernelIso_projection,true),(`LinearStudy.chainActualHomCochainHomologyCokernelIso_coefficient_naturality,true),(`LinearStudy.acyclicResolutionGlobalExtActualHomologyIso_coefficient_naturality,true)]
  let env ← Lean.getEnv
  for (n,want) in checks do
    let some info := env.find? n | throwError "Missing declaration"
    unless (← Lean.Meta.isProp info.type) == want do
      throwError m!"Incorrect semantic proof role: {n}"
    Lean.logInfo m!"ROLECHECK:{n}:{want}"
