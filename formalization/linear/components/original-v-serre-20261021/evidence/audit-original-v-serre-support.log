    ((CategoryTheory.evaluation (TopologicalSpace.Opens ↥X)ᵒᵖ AddCommGrpCat).obj (Opposite.op V))
def LinearStudy.topFormalFreeValueHomAddEquiv.{u} : (X : AlgebraicGeometry.Scheme) →
  (V : X.Opens) →
    (M : AddCommGrpCat) →
      (U : CategoryTheory.Limits.FormalCoproduct X.Opens) →
        (((LinearStudy.orderedFreeOpenFormalPresheafFunctor X).obj U).obj (Opposite.op V) ⟶ M) ≃+
          ((i : U.I) × ULift.{u, u} (V ⟶ U.obj i) → ↑M) :=
fun (X : AlgebraicGeometry.Scheme) (V : X.Opens) (M : AddCommGrpCat)
    (U : CategoryTheory.Limits.FormalCoproduct X.Opens) =>
  ((CategoryTheory.preadditiveYoneda.obj M).mapIso
          ((LinearStudy.topFormalFreePresheafEvaluationIso X V).app U).symm.op).addCommGroupIsoToAddEquiv.trans
    (LinearStudy.nativeFreeCoproductHomAddEquiv (fun (i : U.I) => ULift.{u, u} (V ⟶ U.obj i)) M)
