  {ι : Type u} → [LinearOrder ι] → (ι → X.Opens) → ChainComplex (TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace) ℕ :=
fun (X : AlgebraicGeometry.Scheme) {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) =>
  ((CategoryTheory.presheafToSheaf (Opens.grothendieckTopology ↥X) AddCommGrpCat).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj
    (LinearStudy.orderedFreeAbelianPresheafComplex X U)
def LinearStudy.orderedToNativeFullFreeSheafChain.{u} : (X : AlgebraicGeometry.Scheme) →
  {ι : Type u} →
    [inst : LinearOrder ι] →
      (U : ι → X.Opens) →
        LinearStudy.orderedFreeAbelianSheafComplex X U ⟶
          (AlgebraicTopology.alternatingFaceMapComplex (TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace)).obj
            (LinearStudy.topCechFreeAbelianAugmented (↑X.toPresheafedSpace) U).left :=
fun (X : AlgebraicGeometry.Scheme) {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) =>
  let S := CategoryTheory.presheafToSheaf (Opens.grothendieckTopology ↥X) AddCommGrpCat;
  have e :=
    (AlgebraicTopology.alternatingFaceMapComplex
          (CategoryTheory.Functor (TopologicalSpace.Opens ↥X)ᵒᵖ AddCommGrpCat)).mapIso
      (LinearStudy.topCechFreePresheafSimplicialIso (↑X.toPresheafedSpace) U);
  CategoryTheory.CategoryStruct.comp
    ((S.mapHomologicalComplex (ComplexShape.down ℕ)).map
      (CategoryTheory.CategoryStruct.comp (LinearStudy.orderedToFullFreePresheafChain X U) e.inv))
    ((AlgebraicTopology.alternatingFaceMapComplexCompMapHomologicalComplexIso S).app
        (LinearStudy.topCechFreeAbelianPresheafAugmented (↑X.toPresheafedSpace) U).left).hom
def LinearStudy.orderedCechNativeIntegerAugmentation.{u} : (X : AlgebraicGeometry.Scheme) →
  {ι : Type u} →
    [inst : LinearOrder ι] →
      (U : ι → X.Opens) →
        LinearStudy.orderedFreeAbelianSheafComplex X U ⟶
          (ChainComplex.single₀ (TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace)).obj
            ((CategoryTheory.constantSheaf (Opens.grothendieckTopology ↥X) AddCommGrpCat).obj ↧(ULift.{u, 0} ℤ)) :=
fun (X : AlgebraicGeometry.Scheme) {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) =>
  CategoryTheory.CategoryStruct.comp (LinearStudy.orderedToNativeFullFreeSheafChain X U)
    (LinearStudy.topCechNativeIntegerAugmentation (↑X.toPresheafedSpace) U)
def LinearStudy.orderedTopAbelianCechComplex.{u} : (X : AlgebraicGeometry.Scheme) →
  {ι : Type u} →
    [LinearOrder ι] →
      (ι → X.Opens) → TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace → CochainComplex AddCommGrpCat ℕ :=
fun (X : AlgebraicGeometry.Scheme) {ι : Type u} [LinearOrder ι] (U : ι → X.Opens)
    (F : TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace) =>
  LinearStudy.orderedFormalCechComplex ((CategoryTheory.Limits.FormalCoproduct.evalOp X.Opens AddCommGrpCat).obj F.obj)
    U
def LinearStudy.orderedFreeSheafActualHomComplexIso.{u} : (X : AlgebraicGeometry.Scheme) →
  {ι : Type u} →
    [inst : LinearOrder ι] →
      (U : ι → X.Opens) →
        (F : TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace) →
          LinearStudy.chainActualHomCochain (LinearStudy.orderedFreeAbelianSheafComplex X U) F ≅
            LinearStudy.orderedTopAbelianCechComplex X U F :=
fun (X : AlgebraicGeometry.Scheme) {ι : Type u} [LinearOrder ι] (U : ι → X.Opens)
    (F : TopCat.Sheaf AddCommGrpCat ↑X.toPresheafedSpace) =>
  let P := LinearStudy.orderedFreeOpenFormalPresheafFunctor X;
  let K := LinearStudy.topOpenFreeAbelianPresheafFunctor ↑X.toPresheafedSpace;
  let S := CategoryTheory.presheafToSheaf (Opens.grothendieckTopology ↥X) AddCommGrpCat;
  let YS := CategoryTheory.preadditiveYoneda.obj F;
  let YP := CategoryTheory.preadditiveYoneda.obj F.obj;
  have a := CategoryTheory.Functor.isoWhiskerRight (P.opComp S) YS;
  have b := P.op.associator S.op YS;
  have c :=
    P.op.isoWhiskerLeft
      (LinearStudy.nativeAdjunctionHomPresheafIso
        (CategoryTheory.sheafificationAdjunction (Opens.grothendieckTopology ↥X) AddCommGrpCat) F);
  have d := LinearStudy.formalCoproductContravariantEvaluationIso K YP;
  have e :=
    (CategoryTheory.Limits.FormalCoproduct.evalOp X.Opens AddCommGrpCat).mapIso
      (LinearStudy.topOpenFreeAbelianPresheafHomPresheafIso (↑X.toPresheafedSpace) F);
  LinearStudy.actualHomSourceComplexIso (LinearStudy.orderedCovariantWhiskeringChainIso U P S) F ≪≫
    LinearStudy.orderedFormalActualHomCochainIso U (P.comp S) F ≪≫
      LinearStudy.orderedFormalCechComplexIso U (a ≪≫ b ≪≫ c ≪≫ d ≪≫ e)
def LinearStudy.baseModulePresheafActualAbelianIso.{u} : {X S : AlgebraicGeometry.Scheme} →
  (π : X ⟶ S) →
    (M : X.Modules) →
      (AlgebraicGeometry.Scheme.Modules.baseModulePresheaf π M).comp
          (CategoryTheory.forget₂ (ModuleCat ↑(S.presheaf.obj (Opposite.op ⊤))) AddCommGrpCat) ≅
        ((LinearStudy.schemeModuleToActualAbelianSheaf X).obj M).obj :=
fun {X S : AlgebraicGeometry.Scheme} (π : X ⟶ S) (M : X.Modules) =>
  CategoryTheory.Iso.refl
    ((AlgebraicGeometry.Scheme.Modules.baseModulePresheaf π M).comp
      (CategoryTheory.forget₂ (ModuleCat ↑(S.presheaf.obj (Opposite.op ⊤))) AddCommGrpCat))
def LinearStudy.orderedModuleCechActualAbelianComplexIso.{u} : {X S : AlgebraicGeometry.Scheme} →
  (π : X ⟶ S) →
    (M : X.Modules) →
      {ι : Type u} →
        [inst : LinearOrder ι] →
          (U : ι → X.Opens) →
            ((CategoryTheory.forget₂ (ModuleCat ↑(S.presheaf.obj (Opposite.op ⊤))) AddCommGrpCat).mapHomologicalComplex
                    (ComplexShape.up ℕ)).obj
                (AlgebraicGeometry.Scheme.Modules.orderedBaseCechComplex π M U) ≅
              LinearStudy.orderedTopAbelianCechComplex X U ((LinearStudy.schemeModuleToActualAbelianSheaf X).obj M) :=
fun {X S : AlgebraicGeometry.Scheme} (π : X ⟶ S) (M : X.Modules) {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) =>
  let T := AlgebraicGeometry.Scheme.Modules.baseModulePresheaf π M;
  let H := CategoryTheory.forget₂ (ModuleCat ↑(S.presheaf.obj (Opposite.op ⊤))) AddCommGrpCat;
  let F := (CategoryTheory.Limits.FormalCoproduct.evalOp X.Opens (ModuleCat ↑(S.presheaf.obj (Opposite.op ⊤)))).obj T;
  have e := CategoryTheory.Iso.refl (AlgebraicGeometry.Scheme.Modules.orderedBaseCechComplex π M U);
  (H.mapHomologicalComplex (ComplexShape.up ℕ)).mapIso e ≪≫
    LinearStudy.orderedFormalCechWhiskeringIso U F H ≪≫
      LinearStudy.orderedFormalCechComplexIso U
        (LinearStudy.formalProductEvaluationWhiskeringIso T H ≪≫
          (CategoryTheory.Limits.FormalCoproduct.evalOp X.Opens AddCommGrpCat).mapIso
            (LinearStudy.baseModulePresheafActualAbelianIso π M))
def LinearStudy.orderedSimplexPrependBottom.{u} : {ι : Type u} →
  [inst : LinearOrder ι] →
    [inst_1 : OrderBot ι] →
      {n : ℕ} →
        (a : AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι n) →
          ⊥ < ↑a 0 → AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι (n + 1) :=
fun {ι : Type u} [LinearOrder ι] [OrderBot ι] {n : ℕ} (a : AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι n)
    (h : ⊥ < ↑a 0) =>
  ⟨Fin.cons ⊥ ↑a, ⋯⟩
def LinearStudy.orderedCechFormalInclusion.{u} : {X : AlgebraicGeometry.Scheme} →
  {ι : Type u} →
    [inst : LinearOrder ι] →
      (U : ι → X.Opens) →
        (n : ℕ) →
          AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U n ⟶ { I := ι, obj := U }.power (Fin (n + 1)) :=
fun {X : AlgebraicGeometry.Scheme} {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) (n : ℕ) =>
  { f := fun (i : (AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U n).I) => ↑i,
    φ := fun (x : (AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U n).I) =>
      CategoryTheory.CategoryStruct.id ((AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U n).obj x) }
def LinearStudy.orderedCechDegreeZeroIndexEquiv.{u} : {ι : Type u} →
  [inst : Preorder ι] → AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι 0 ≃ (Fin 1 → ι) :=
fun {ι : Type u} [Preorder ι] =>
  { toFun := fun (a : AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι 0) => ↑a,
    invFun := fun (a : Fin 1 → ι) => ⟨a, ⋯⟩, left_inv := ⋯, right_inv := ⋯ }
def LinearStudy.orderedCechFormalDegreeZeroIso.{u} : {X : AlgebraicGeometry.Scheme} →
  {ι : Type u} →
    [inst : LinearOrder ι] →
      (U : ι → X.Opens) →
        AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U 0 ≅ { I := ι, obj := U }.power (Fin 1) :=
fun {X : AlgebraicGeometry.Scheme} {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) =>
  CategoryTheory.Limits.FormalCoproduct.isoOfComponents LinearStudy.orderedCechDegreeZeroIndexEquiv
    fun (x : (AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U 0).I) =>
    CategoryTheory.Iso.refl ((AlgebraicGeometry.Scheme.Modules.orderedCechFormalObject U 0).obj x)
theorem LinearStudy.orderedCechFormalInclusion_zero_isIso.{u} : ∀ {X : AlgebraicGeometry.Scheme} {ι : Type u}
  [inst : LinearOrder ι] (U : ι → X.Opens), CategoryTheory.IsIso (LinearStudy.orderedCechFormalInclusion U 0) :=
fun {X : AlgebraicGeometry.Scheme} {ι : Type u} [LinearOrder ι] (U : ι → X.Opens) => id inferInstance
def LinearStudy.orderedToFullFormalCechChain.{u, v, w} : {X : AlgebraicGeometry.Scheme} →
  {A : Type w} →
    [inst : CategoryTheory.Category.{v, w} A] →
      [inst_1 : CategoryTheory.Preadditive A] →
        (F : CategoryTheory.Functor (CategoryTheory.Limits.FormalCoproduct X.Opens) A) →
          {ι : Type u} →
            [inst_2 : LinearOrder ι] →
              (U : ι → X.Opens) →
                HomologicalComplex.unop (LinearStudy.orderedFormalCechComplex F.op U) ⟶
                  (AlgebraicTopology.alternatingFaceMapComplex A).obj
                    (CategoryTheory.Functor.comp { I := ι, obj := U }.cech F) :=
fun {X : AlgebraicGeometry.Scheme} {A : Type w} [CategoryTheory.Category.{v, w} A] [CategoryTheory.Preadditive A]
    (F : CategoryTheory.Functor (CategoryTheory.Limits.FormalCoproduct X.Opens) A) {ι : Type u} [LinearOrder ι]
    (U : ι → X.Opens) =>
  ChainComplex.ofHom (fun (n : ℕ) => F.map (LinearStudy.orderedCechFormalInclusion U n)) ⋯
def LinearStudy.schemeModuleIsoRestrictionEquivalence.{u} : {X Y : AlgebraicGeometry.Scheme} →
  (X ≅ Y) → (X.Modules ≌ Y.Modules) :=
fun {X Y : AlgebraicGeometry.Scheme} (e : X ≅ Y) =>
  CategoryTheory.Equivalence.mk (AlgebraicGeometry.Scheme.Modules.restrictFunctor e.inv)
    (AlgebraicGeometry.Scheme.Modules.restrictFunctor e.hom)
    (AlgebraicGeometry.Scheme.Modules.restrictFunctorId.symm ≪≫
      (AlgebraicGeometry.Scheme.Modules.restrictFunctorCongr ⋯).symm ≪≫
        AlgebraicGeometry.Scheme.Modules.restrictFunctorComp e.hom e.inv)
    ((AlgebraicGeometry.Scheme.Modules.restrictFunctorComp e.inv e.hom).symm ≪≫
      AlgebraicGeometry.Scheme.Modules.restrictFunctorCongr ⋯ ≪≫ AlgebraicGeometry.Scheme.Modules.restrictFunctorId)
def LinearStudy.schemeModuleOpenRestrictionActualAbelianIso.{u} : (X : AlgebraicGeometry.Scheme) →
  (U : X.Opens) →
    (AlgebraicGeometry.Scheme.Modules.restrictFunctor U.ι).comp (LinearStudy.schemeModuleToActualAbelianSheaf ↑U) ≅
      (LinearStudy.schemeModuleToActualAbelianSheaf X).comp
        (LinearStudy.topOpenAbelianSheafRestriction (↑X.toPresheafedSpace) U) :=
fun (X : AlgebraicGeometry.Scheme) (U : X.Opens) =>
  ((CategoryTheory.fullyFaithfulSheafToPresheaf (Opens.grothendieckTopology ↥↑U) AddCommGrpCat).whiskeringRight
        X.Modules).preimageIso
    (LinearStudy.schemeModuleOpenRestriction_toPresheafIso U.ι)
def LinearStudy.schemeModuleSchemeIsoGlobalExtAddEquiv.{u} : {X Y : AlgebraicGeometry.Scheme} →
  (e : X ≅ Y) →
    (M : X.Modules) →
      (n : ℕ) →
        CategoryTheory.Abelian.Ext (SheafOfModules.unit X.ringCatSheaf) M n ≃+
          CategoryTheory.Abelian.Ext (SheafOfModules.unit Y.ringCatSheaf) (M.restrict e.inv) n :=
fun {X Y : AlgebraicGeometry.Scheme} (e : X ≅ Y) (M : X.Modules) (n : ℕ) =>
  let R := AlgebraicGeometry.Scheme.Modules.restrictFunctor e.inv;
  let point := (AlgebraicGeometry.Scheme.Modules.restrictUnitIso e.inv).inv;
  AddEquiv.ofBijective (LinearStudy.pointedExactFunctorExtMap R point M n) ⋯
def LinearStudy.schemeModuleSpecOpenSectionsEquiv.{u} : {X : AlgebraicGeometry.Scheme} →
  {R : CommRingCat} →
    (M : X.Modules) →
      (f : AlgebraicGeometry.Spec R ⟶ X) →
        [inst : AlgebraicGeometry.IsOpenImmersion f] →
          (W : (AlgebraicGeometry.Spec R).Opens) →
            (U : X.Opens) →
              (AlgebraicGeometry.Scheme.Hom.opensFunctor f).obj W = U →
                ↑(M.presheaf.obj (Opposite.op U)) ≃+ ↑((M.restrict f).presheaf.obj (Opposite.op W)) :=
fun {X : AlgebraicGeometry.Scheme} {R : CommRingCat} (M : X.Modules) (f : AlgebraicGeometry.Spec R ⟶ X)
    [AlgebraicGeometry.IsOpenImmersion f] (W : (AlgebraicGeometry.Spec R).Opens) (U : X.Opens)
    (himage : (AlgebraicGeometry.Scheme.Hom.opensFunctor f).obj W = U) =>
  (CategoryTheory.Functor.mapIso M.presheaf (CategoryTheory.eqToIso himage).op ≪≫
      (AlgebraicGeometry.Scheme.Modules.restrictAppIso f M W).symm).addCommGroupIsoToAddEquiv
