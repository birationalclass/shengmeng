def LinearStudy.orderedCrossSpaceAbelianCechComplexIso.{u} : {X Y : AlgebraicGeometry.Scheme} →
  {ι : Type u} →
    [inst : LinearOrder ι] →
      (F : CategoryTheory.Functor X.Opensᵒᵖ AddCommGrpCat) →
        (G : CategoryTheory.Functor Y.Opensᵒᵖ AddCommGrpCat) →
          (U : ι → X.Opens) →
            (V : ι → Y.Opens) →
              (e :
                  (p : ℕ) →
                    (t : AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι p) →
                      F.obj (Opposite.op (∏ᶜ fun (l : Fin (p + 1)) => U (↑t l))) ≅
                        G.obj (Opposite.op (∏ᶜ fun (l : Fin (p + 1)) => V (↑t l)))) →
                (∀ (p : ℕ) (k : Fin (p + 2)) (t : AlgebraicGeometry.Scheme.Modules.OrderedCechIndex ι (p + 1)),
                    CategoryTheory.CategoryStruct.comp (e p (t.delete k)).hom
                        (G.map ((AlgebraicGeometry.Scheme.Modules.orderedCechFace V p k).φ t).op) =
                      CategoryTheory.CategoryStruct.comp
                        (F.map ((AlgebraicGeometry.Scheme.Modules.orderedCechFace U p k).φ t).op) (e (p + 1) t).hom) →
                  (LinearStudy.orderedFormalCechComplex
                      ((CategoryTheory.Limits.FormalCoproduct.evalOp X.Opens AddCommGrpCat).obj F) U ≅
                    LinearStudy.orderedFormalCechComplex
                      ((CategoryTheory.Limits.FormalCoproduct.evalOp Y.Opens AddCommGrpCat).obj G) V) :=
