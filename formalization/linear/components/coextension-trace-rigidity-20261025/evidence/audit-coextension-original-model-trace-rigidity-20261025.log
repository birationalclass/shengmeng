                                {κ : Type} →
                                  (c : κ → S) →
                                    (∀ (i : κ), c i ∈ B 1) →
                                      Algebra.adjoin K (Set.range c) = ⊤ →
                                        (q : ℕ) →
                                          Fintype.card σ = q + 2 →
                                            LinearStudy.schemeModuleActualCohomology (AlgebraicGeometry.Proj B)
                                                (LinearStudy.nativeProjectiveModuleSheaf B
                                                  (LinearStudy.coextensionGradedPiece
                                                    (MvPolynomial.homogeneousSubmodule σ K) B)
                                                  ⋯ (-↑(Fintype.card σ)))
                                                (q + 1) →+
                                              K :=
fun {K S : Type} [Field K] {σ : Type} [Fintype σ] [LinearOrder σ] [CommRing S] [Algebra K S]
    [Algebra (MvPolynomial σ K) S] [IsScalarTower K (MvPolynomial σ K) S] (B : ℕ → Submodule K S) [GradedAlgebra B]
    [SetLike.GradedSMul (MvPolynomial.homogeneousSubmodule σ K) B] [IsDomain S] [IsNoetherianRing S]
    [Algebra.FiniteType K S] [Module.Finite (MvPolynomial σ K) S] {κ : Type} (c : κ → S) (hc : ∀ (i : κ), c i ∈ B 1)
    (hgenC : Algebra.adjoin K (Set.range c) = ⊤) (q : ℕ) (hcard : Fintype.card σ = q + 2) =>
  (LinearMap.toAddMonoidHom
        ((Module.Dual.eval K
            ↥(LinearStudy.integerGradedHomPiece (MvPolynomial.homogeneousSubmodule σ K)
                (LinearStudy.coextensionGradedPiece (MvPolynomial.homogeneousSubmodule σ K) B)
                (-↑(Fintype.card σ) - -↑(Fintype.card σ))))
          (LinearStudy.nativeCoextensionSpecifiedTopEvaluationHom B))).comp
    (AddCommGrpCat.Hom.hom
      (LinearStudy.nativeFiniteNormalization_specifiedActualTopHomDualIso B
          (LinearStudy.coextensionGradedPiece (MvPolynomial.homogeneousSubmodule σ K) B) ⋯ ⋯ c hc hgenC q hcard
          (-↑(Fintype.card σ))).hom)
'LinearStudy.nativeCoextensionSpecifiedTopEvaluationTrace' depends on axioms: [propext, Classical.choice, Quot.sound]
def LinearStudy.coextensionOriginalAdjoint.{u} : {R S M : Type u} →
  [inst : CommRing R] →
    [inst_1 : CommRing S] →
      [inst_2 : Algebra R S] →
        [inst_3 : AddCommGroup M] →
          [inst_4 : Module R M] →
            [inst_5 : Module S M] →
              [IsScalarTower R S M] →
                Module.Dual R M → M →ₗ[S] ↑((ModuleCat.coextendScalars (algebraMap R S)).obj ↧R) :=
fun {R S M : Type u} [CommRing R] [CommRing S] [Algebra R S] [AddCommGroup M] [Module R M] [Module S M]
    [IsScalarTower R S M] (phi : Module.Dual R M) =>
  have g :=
    ModuleCat.ofHom
      { toFun := fun (x : ↑((ModuleCat.restrictScalars (algebraMap R S)).obj ↧M)) => phi x, map_add' := ⋯,
        map_smul' := ⋯ };
  ModuleCat.Hom.hom (ModuleCat.RestrictionCoextensionAdj.HomEquiv.fromRestriction (algebraMap R S) g)
