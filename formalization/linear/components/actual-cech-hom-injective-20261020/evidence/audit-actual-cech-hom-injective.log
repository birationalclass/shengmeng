        LinearStudy.topCechFreeSheafHomComplex X U F ≅ (CategoryTheory.cechComplexFunctor U).obj F.obj :=
fun (X : TopCat) {ι : Type u} (U : ι → TopologicalSpace.Opens ↑X) (F : TopCat.Sheaf AddCommGrpCat X) =>
  (AlgebraicTopology.alternatingCofaceMapComplex AddCommGrpCat).mapIso
    (LinearStudy.topCechFreeSheafHomCosimplicialIso X U F)
def LinearStudy.alternatingHomCochainIso.{u, v, u', v'} : {A : Type u} →
  [inst : CategoryTheory.Category.{v, u} A] →
    [inst_1 : CategoryTheory.Preadditive A] →
      {B : Type u'} →
        [inst_2 : CategoryTheory.Category.{v', u'} B] →
          [inst_3 : CategoryTheory.Preadditive B] →
            (S : CategoryTheory.SimplicialObject A) →
              (H : CategoryTheory.Functor Aᵒᵖ B) →
                [inst_4 : H.Additive] →
                  (H.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                      (HomologicalComplex.op ((AlgebraicTopology.alternatingFaceMapComplex A).obj S)) ≅
                    (AlgebraicTopology.alternatingCofaceMapComplex B).obj ((CategoryTheory.Functor.rightOp S).comp H) :=
fun {A : Type u} [CategoryTheory.Category.{v, u} A] [CategoryTheory.Preadditive A] {B : Type u'}
    [CategoryTheory.Category.{v', u'} B] [CategoryTheory.Preadditive B] (S : CategoryTheory.SimplicialObject A)
    (H : CategoryTheory.Functor Aᵒᵖ B) [H.Additive] =>
  HomologicalComplex.Hom.isoOfComponents
    (fun (x : ℕ) =>
      CategoryTheory.Iso.refl
        (((H.mapHomologicalComplex (ComplexShape.up ℕ)).obj
              (HomologicalComplex.op ((AlgebraicTopology.alternatingFaceMapComplex A).obj S))).X
          x))
    ⋯
