        "bytes": 1049804,
        "segments": [
          {
            "start": 0.3,
            "end": 3.2017708333333332,
            "text": "我们先定义两种重要的子群类型。"
          },
          {
            "start": 3.7517708333333335,
            "end": 8.223041666666667,
            "text": "设G为有限群，p为整除|G|的素数。"
          },
          {
            "start": 8.773041666666668,
            "end": 17.264125,
            "text": "写成 |G|=p^a m，其中p∤m；a就是|G|中p的最高指数。"
          },
          {
            "start": 17.814125,
            "end": 24.42235416666667,
            "text": "教材把阶为p^r、r≥1的有限群称为p群。"
          },
          {
            "start": 24.97235416666667,
            "end": 26.794125,
            "text": "单位群不在这个定义里。"
          },
          {
            "start": 27.344125000000002,
            "end": 31.183770833333334,
            "text": "G的子群H如果自身是p群，就叫p子群。"
          },
          {
            "start": 31.733770833333335,
            "end": 38.32160416666667,
            "text": "由拉格朗日定理，|H|=p^r时有r≤a。"
          },
          {
            "start": 38.871604166666664,
            "end": 45.48975,
            "text": "西罗p子群P的阶恰好是p^a，达到|G|中最大的p幂。"
          },
          {
            "start": 46.03975,
            "end": 49.045375,
            "text": "这里的P是子群，p是素数。"
          },
          {
            "start": 49.595375,
            "end": 52.12775,
            "text": "定义还没有保证这样的子群存在。"
          }
